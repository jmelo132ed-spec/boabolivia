---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BoaSearchBar from '../components/boa/BoaSearchBar.astro';
import BoaBookingChrome from '../components/boa/BoaBookingChrome.astro';
import BoaPayBoard from '../components/boa/BoaPayBoard.astro';
import PaymentBoard from '../components/checkout/PaymentBoard.astro';
import { BOA_STATIONS } from '../data/boaStations';
import { parseOffersQuery } from '../services/searchQuery';

const query = parseOffersQuery(Astro.url.searchParams);
const origin = query.origin;
const destination = query.destination;
const from = BOA_STATIONS.find((c) => c.code === origin) ?? { city: origin || 'Origen', code: origin || '—', airport: '' };
const to = BOA_STATIONS.find((c) => c.code === destination) ?? { city: destination || 'Destino', code: destination || '—', airport: '' };
---

<Layout title="Pagar reserva | BoA" bodyClass="boa-page boa-reserva is-pagos-page is-boa-pay">
  <div class="boa-pay-overlay" id="boa-pay-overlay" hidden aria-hidden="true" role="status" aria-live="polite" aria-label="Cargando">
    <div class="boa-pay-splash">
      <img class="boa-pay-splash__logo" src="/images/boa/iso.svg" width="64" height="64" alt="" />
      <span class="boa-pay-splash__ring boa-pay-splash__ring--in" aria-hidden="true"></span>
      <span class="boa-pay-splash__ring boa-pay-splash__ring--out" aria-hidden="true"></span>
    </div>
  </div>

  <BoaBookingChrome
    origin={from.code}
    destination={to.code}
    originCity={from.city}
    destinationCity={to.city}
    depart={query.depart}
    returnDate={query.returnDate}
    trip={query.trip}
    adults={Number(query.adults)}
    children={Number(query.children)}
    infants={Number(query.infants)}
    currentStep={4}
  >
    <BoaSearchBar
      embedded
      prefill={{
        origin,
        destination,
        depart: query.depart,
        returnDate: query.returnDate,
        trip: query.trip,
        adults: query.adults,
        children: query.children,
        infants: query.infants,
      }}
    />
  </BoaBookingChrome>

  <div class="checkout-scroll boa-res-scroll pagos-scroll">
    <BoaPayBoard />
    <div id="boa-pasarela">
      <PaymentBoard />
    </div>
  </div>
</Layout>
