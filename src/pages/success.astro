---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BoaHeader from '../components/boa/BoaHeader.astro';
---

<Layout title="public: Confirmation | BoA" bodyClass="boa-page boa-kx-page">
  <BoaHeader />
  <main class="boa-kx">
    <div class="boa-kx__wrap">
      <section class="boa-kx-thanks">
        <div class="boa-kx-thanks__inner">
          <svg class="boa-kx-thanks__icon" viewBox="0 0 50 50" width="44" height="44" aria-hidden="true">
            <path fill="currentColor" d="M25 42c-9.4 0-17-7.6-17-17S15.6 8 25 8s17 7.6 17 17s-7.6 17-17 17m0-32c-8.3 0-15 6.7-15 15s6.7 15 15 15s15-6.7 15-15s-6.7-15-15-15"></path>
            <path fill="currentColor" d="m23 32.4-8.7-8.7 1.4-1.4 7.3 7.3 11.3-11.3 1.4 1.4z"></path>
          </svg>
          <h1>¡Gracias por viajar con nosotros!</h1>
          <p>En la parte inferior encontrarás la información de tu reserva.</p>
          <p class="boa-kx-thanks__mail">
            Sus tiquetes aéreos se encuentran en proceso de emisión. En un plazo máximo de 24 horas los enviaremos a su correo electrónico <strong id="success-email"></strong>.
          </p>
        </div>
      </section>

      <section class="boa-kx-pnr">
        <h2>Código de reserva</h2>
        <strong id="success-booking-code"></strong>
      </section>

      <article class="boa-kx-pay" data-kx-acc>
        <button type="button" class="boa-kx-pay__summary" id="boa-kx-toggle" aria-expanded="false" aria-controls="boa-kx-pay-body">
          <span class="boa-kx-pay__left">
            <span class="boa-kx-chip" id="boa-kx-chip">Ver detalle</span>
          </span>
          <span class="boa-kx-pay__copy">
            Nos complace informarle que su pago ha sido completado con éxito. A continuación, se detalla la información de su transacción
          </span>
          <svg class="boa-kx-pay__chev" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path fill="currentColor" d="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z"></path>
          </svg>
        </button>
        <div class="boa-kx-pay__body" id="boa-kx-pay-body" hidden>
          <p>Método de Pago: <b id="boa-kx-method">()</b></p>
          <p>Cuenta del Pagador: <b id="boa-kx-account"></b></p>
        </div>
      </article>

      <section class="boa-kx-itin">
        <h2>Tu itinerario de viaje.</h2>
        <p>Revisa las siguientes recomendaciones antes de viajar.</p>
        <div id="boa-kx-legs"></div>
      </section>

      <a class="boa-kx-search" href="/">Buscar otro vuelo</a>
    </div>
  </main>
  <script>
    const BOOKING_KEY = 'latam-booking-code';
    const STORAGE_KEY = 'latam-checkout-selection';
    const PAX_KEY = 'latam-passenger-draft';
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    const DAYS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
    const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
    const BRANDS = {
      visa: 'Visa',
      mastercard: 'Mastercard',
      amex: 'American Express',
      diners: 'Diners Club',
      discover: 'Discover',
    };

    function randomBookingCode() {
      let code = '';
      const bytes = new Uint8Array(6);
      crypto.getRandomValues(bytes);
      for (const byte of bytes) code += chars[byte % chars.length];
      return code;
    }

    function readJson(key, fallback) {
      try {
        return JSON.parse(sessionStorage.getItem(key) || 'null') ?? fallback;
      } catch {
        return fallback;
      }
    }

    let bookingCode = '';
    try {
      bookingCode = String(sessionStorage.getItem(BOOKING_KEY) || '').trim();
      if (!/^[A-Z0-9]{6}$/.test(bookingCode)) {
        bookingCode = randomBookingCode();
        sessionStorage.setItem(BOOKING_KEY, bookingCode);
      }
    } catch {
      bookingCode = randomBookingCode();
    }

    const codeSlot = document.getElementById('success-booking-code');
    if (codeSlot) codeSlot.textContent = bookingCode;

    const draft = readJson('latam-payment-draft', {});
    const paxDraft = readJson(PAX_KEY, {});
    const brand = String(draft?.brand || '').toLowerCase();
    const method = BRANDS[brand] || '';
    const methodSlot = document.getElementById('boa-kx-method');
    if (methodSlot) methodSlot.textContent = `(${method})`;

    function asEmail(value) {
      return String(value || '').trim();
    }
    const email =
      asEmail(draft?.email) ||
      asEmail(paxDraft?.email) ||
      asEmail(paxDraft?.travelers?.[0]?.email);
    const emailSlot = document.getElementById('success-email');
    const emailNote = document.querySelector('.boa-kx-thanks__mail');
    if (emailSlot && email) emailSlot.textContent = email;
    if (emailNote) emailNote.hidden = !email;

    const toggle = document.getElementById('boa-kx-toggle');
    const body = document.getElementById('boa-kx-pay-body');
    const chip = document.getElementById('boa-kx-chip');
    const acc = document.querySelector('[data-kx-acc]');
    toggle?.addEventListener('click', () => {
      const open = acc?.classList.toggle('is-open');
      if (body) body.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (chip) chip.textContent = open ? 'Ocultar detalle' : 'Ver detalle';
    });

    function cityName(value) {
      if (!value) return '';
      if (typeof value === 'string') return value;
      return value.city || value.code || '';
    }

    function cityCode(value) {
      if (!value) return '';
      if (typeof value === 'string') return value;
      return value.code || '';
    }

    function clock(value) {
      const raw = String(value || '').trim();
      const m = raw.match(/(\d{1,2}):(\d{2})/);
      if (!m) return raw;
      return `${String(m[1]).padStart(2, '0')}:${m[2]}`;
    }

    function dateShort(iso) {
      if (!iso) return '';
      const d = new Date(`${iso}T12:00:00`);
      if (Number.isNaN(d.getTime())) return iso;
      const dd = String(d.getDate()).padStart(2, '0');
      return `${DAYS[d.getDay()]}. ${dd} ${MONTHS[d.getMonth()]}. ${d.getFullYear()}`;
    }

    function durationWords(mins, label) {
      const n = Number(mins);
      if (Number.isFinite(n) && n > 0) {
        if (n < 60) return `${n} minutos`;
        const h = Math.floor(n / 60);
        const m = n % 60;
        if (!m) return `${h} ${h === 1 ? 'hora' : 'horas'}`;
        return `${h} ${h === 1 ? 'hora' : 'horas'} y ${m} minutos`;
      }
      return String(label || '');
    }

    function flightCode(value) {
      return String(value || 'OB').replace(/\s+/g, '');
    }

    function planeName(value) {
      const raw = String(value || '').toUpperCase().trim();
      const digits = raw.match(/(\d{3,4})/);
      if (digits) return digits[1];
      return raw.replace(/^B/, '') || '737';
    }

    function operatorShort(seg, flight) {
      const code = String(seg?.operatorCode || flight?.operators?.[0]?.code || 'OB').toUpperCase();
      if (code === 'OB') return 'BOA';
      return code || 'BOA';
    }

    function planeIcon(inbound = false) {
      const flip = inbound ? ' transform="translate(576 0) scale(-1 1)"' : '';
      return `<svg class="boa-rev-plane${inbound ? ' is-back' : ''}" viewBox="0 0 576 512" aria-hidden="true"><g${flip}><path fill="currentColor" d="M482.3 192c34.2 0 93.7 29 93.7 64c0 36-59.5 64-93.7 64H365.7L265.2 495.9c-5.7 10-16.3 16.1-27.8 16.1h-56.2c-10.6 0-18.3-10.2-15.4-20.4l49-171.6H112l-43.2 57.6c-3 4-7.8 6.4-12.8 6.4H14c-7.8 0-14-6.3-14-14c0-1.3.2-2.6.5-3.9L32 256 .5 146.3c-.4-1.3-.5-2.6-.5-3.9c0-7.8 6.3-14 14-14H56c5 0 9.8 2.4 12.8 6.4L112 192h102.9l-49-171.6C162.9 10.2 170.6 0 181.2 0h56.2c11.5 0 22.1 6.2 27.8 16.1L365.7 192h116.6z"/></g></svg>`;
    }

    function segsOf(leg, fromCity, toCity, fromCode, toCode) {
      const flight = leg?.flight || {};
      if (Array.isArray(flight.itinerary) && flight.itinerary.length) {
        return flight.itinerary.map((seg, index, all) => ({
          depart: seg.depart || (index === 0 ? flight.depart : ''),
          arrive: seg.arrive || (index === all.length - 1 ? flight.arrive : ''),
          duration: seg.duration || flight.duration,
          durationMinutes: seg.durationMinutes || flight.durationMinutes,
          flightNumber: seg.flightNumber || flight.flightNumber,
          originCity: seg.originCity || (index === 0 ? fromCity : seg.originCity),
          destCity: seg.destCity || (index === all.length - 1 ? toCity : seg.destCity),
          originCode: seg.originCode || (index === 0 ? fromCode : seg.originCode),
          destCode: seg.destCode || (index === all.length - 1 ? toCode : seg.destCode),
          aircraft: planeName(seg.aircraft),
          operatorCode: seg.operatorCode,
          layover: seg.layover,
        }));
      }
      return [{
        depart: flight.depart,
        arrive: flight.arrive,
        duration: flight.duration,
        durationMinutes: flight.durationMinutes,
        flightNumber: flight.flightNumber,
        originCity: fromCity,
        destCity: toCity,
        originCode: fromCode,
        destCode: toCode,
        aircraft: '737',
        operatorCode: flight.operators?.[0]?.code || 'OB',
      }];
    }

    function stopHtml(time, city, code) {
      return `
        <div class="boa-rev-tl__stop">
          <i class="boa-rev-tl__dot" aria-hidden="true"></i>
          <p><strong>${clock(time)}</strong> ${city || ''} <b>${String(code || '').toUpperCase()}</b></p>
        </div>
      `;
    }

    function timelineHtml(segs, flight, inbound = false) {
      return segs.map((seg, index) => {
        const wait = seg.layover && index < segs.length - 1
          ? `<div class="boa-rev-tl__wait">Escala de ${seg.layover} en ${seg.destCity || seg.destCode}</div>`
          : '';
        return `
          <div class="boa-rev-tl">
            ${stopHtml(seg.depart, seg.originCity, seg.originCode)}
            <div class="boa-rev-tl__mid">
              <i class="boa-rev-tl__line" aria-hidden="true"></i>
              <p>${durationWords(seg.durationMinutes, seg.duration)} ${flightCode(seg.flightNumber)}&nbsp;&nbsp;${operatorShort(seg, flight)}&nbsp;&nbsp;${planeIcon(inbound)} Avión: ${planeName(seg.aircraft)}</p>
            </div>
            ${stopHtml(seg.arrive, seg.destCity, seg.destCode)}
          </div>
          ${wait}
        `;
      }).join('');
    }

    function itineraryBlock(title, iso, segs, flight, inbound = false) {
      return `
        <div class="boa-rev-itin">
          <h3>${title}</h3>
          <p class="boa-rev-itin__date">${planeIcon(inbound)}<span>${dateShort(iso)}</span></p>
          ${timelineHtml(segs, flight, inbound)}
        </div>
      `;
    }

    const selection = readJson(STORAGE_KEY, null);
    const legs = document.getElementById('boa-kx-legs');
    if (legs && selection?.outbound) {
      const from = cityName(selection.from);
      const to = cityName(selection.to);
      const fromCode = cityCode(selection.from);
      const toCode = cityCode(selection.to);
      const blocks = [];
      blocks.push(itineraryBlock(
        'Ida',
        selection.depart,
        segsOf(selection.outbound, from, to, fromCode, toCode),
        selection.outbound.flight,
      ));
      if (selection.inbound?.flight) {
        blocks.push(itineraryBlock(
          'Vuelta',
          selection.returnDate,
          segsOf(selection.inbound, to, from, toCode, fromCode),
          selection.inbound.flight,
          true,
        ));
      }
      const paxDraft = readJson(PAX_KEY, {});
      const first = paxDraft?.travelers?.[0] || paxDraft;
      const who = [first?.first || first?.firstName, first?.last || first?.lastName].filter(Boolean).join(' ');
      legs.innerHTML = `
        <div class="boa-kx-legs">
          ${who ? `<p class="boa-kx-legs__pax">${who}</p>` : ''}
          ${blocks.join('')}
        </div>
      `;
    }
  </script>
</Layout>
