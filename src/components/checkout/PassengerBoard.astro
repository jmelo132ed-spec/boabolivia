---
import { genderOptions, documentTypes } from '../../data/passengerData';
import { allCountries } from '../../data/countries';
import { buildFareOptions } from '../../data/fareBrands';
import { PORCENTAJE_DESCUENTO } from 'astro:env/client';

const fareCatalog = buildFareOptions(1, 'economy');
---

<section class="boa-pax" id="pax-board">
  <p class="av-pax__error hidden" id="pax-error" hidden></p>
  <div class="boa-pax__main">
    <div class="boa-pax__intro">
      <div>
        <h1>Pasajeros</h1>
        <p class="boa-pax__lead">Por favor verifica que la información de los pasajeros sea correcta antes de continuar.</p>
      </div>
      <span class="boa-pax__badge">Económica</span>
    </div>
    <div id="pax-forms"></div>
    <div class="boa-pax__nav">
      <button type="button" class="boa-pax__back" id="pax-back">Atrás</button>
      <button type="button" class="boa-pax__cta" data-pax-continue>Continuar</button>
    </div>
  </div>

  <div class="av-pax-sheet-bg" id="pax-sheet-bg" hidden></div>
  <div class="av-pax-dock">
    <footer class="av-pax-bar" id="pax-bar">
      <button type="button" class="av-pax-bar__handle" id="pax-summary-toggle" aria-expanded="false">
        <span>Resumen del viaje</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M6 14L12 8L18 14"/></svg>
      </button>
      <div class="av-pax-bar__drawer" id="pax-summary-drawer" hidden></div>
      <div class="av-pax-bar__row">
        <div class="av-pax-bar__legs" id="pax-bar-legs"></div>
        <div class="av-pax-bar__meta">
          <strong id="pax-bar-count">1 pasajero</strong>
          <span>Pasajeros</span>
        </div>
        <div class="av-pax-bar__price">
          <strong id="pax-bar-total">USD 0,00</strong>
          <span>Total de tu reserva</span>
        </div>
        <button type="button" class="av-pax-bar__cta" id="pax-continue" data-pax-continue>Continuar</button>
      </div>
    </footer>
    <p class="av-pax__copy">© BoA — Boliviana de Aviación 2026</p>
  </div>
</section>

<script define:vars={{ countries: allCountries, genderOptions, documentTypes, PORCENTAJE_DESCUENTO, fareCatalog }}>
  const STORAGE_KEY = 'latam-checkout-selection';
  const PAX_KEY = 'latam-passenger-draft';
  const formsRoot = document.getElementById('pax-forms');
  const errorBox = document.getElementById('pax-error');
  let selectDialCountry = () => {};
  const discountPct = Number(PORCENTAJE_DESCUENTO) || 0;
  const MONTHS = [
    ['01', 'Enero'], ['02', 'Febrero'], ['03', 'Marzo'], ['04', 'Abril'],
    ['05', 'Mayo'], ['06', 'Junio'], ['07', 'Julio'], ['08', 'Agosto'],
    ['09', 'Septiembre'], ['10', 'Octubre'], ['11', 'Noviembre'], ['12', 'Diciembre'],
  ];
  const DAYS_SHORT = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  const MONTHS_SHORT = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'Sept', 'oct', 'nov', 'dic'];
  const MONTHS_LONG = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

  function money(value) {
    const n = Number(value) || 0;
    const [int, dec] = n.toFixed(2).split('.');
    return `USD ${int.replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${dec}`;
  }

  function ticketAfterDiscount(original) {
    const raw = Math.round((Number(original) || 0) * 100) / 100;
    const tax = Math.round(raw * (233.56 / 1162.56) * 100) / 100;
    const fare = Math.max(0, Math.round((raw - tax) * 100) / 100);
    if (!(discountPct > 0)) return Math.round((fare + tax) * 100) / 100;
    const fareAfter = Math.round(fare * (1 - Math.min(100, discountPct) / 100) * 100) / 100;
    return Math.round((fareAfter + tax) * 100) / 100;
  }

  function readJson(key, fallback) {
    try {
      return JSON.parse(sessionStorage.getItem(key) || 'null') ?? fallback;
    } catch {
      return fallback;
    }
  }

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.toggle('hidden', !message);
    if (message) errorBox.removeAttribute('hidden');
    else errorBox.setAttribute('hidden', '');
  }

  function passengerGroups(selection) {
    const groups = [];
    for (let i = 0; i < (selection.adults || 1); i += 1) groups.push({ type: 'Adulto', label: `Adulto ${i + 1}` });
    for (let i = 0; i < (selection.children || 0); i += 1) groups.push({ type: 'Niño', label: `Niño ${i + 1}` });
    for (let i = 0; i < (selection.infants || 0); i += 1) groups.push({ type: 'Bebé', label: `Bebé ${i + 1}` });
    if (!groups.length) groups.push({ type: 'Adulto', label: 'Adulto 1' });
    return groups;
  }

  function yearOptions() {
    const now = new Date().getFullYear();
    const years = [];
    for (let y = now - 12; y >= now - 100; y -= 1) years.push(y);
    return years;
  }

  function countryLabel(country) {
    try {
      return new Intl.DisplayNames(['es'], { type: 'region' }).of(country.code) || country.name;
    } catch {
      return country.name;
    }
  }

  function flagEmoji(code) {
    const cc = String(code || '').toUpperCase();
    if (cc.length !== 2) return '';
    return String.fromCodePoint(...[...cc].map((ch) => 127397 + ch.charCodeAt(0)));
  }

  function officialName(country) {
    const code = String(country?.code || '').toUpperCase();
    const longNames = {
      BO: 'Bolivia, Plurinational State of',
      VE: 'Venezuela, Bolivarian Republic of',
      IR: 'Iran, Islamic Republic of',
      KR: 'Korea, Republic of',
      RU: 'Russian Federation',
      GB: 'United Kingdom',
      US: 'United States of America',
      AE: 'United Arab Emirates',
      CD: 'Congo, The Democratic Republic of the',
      TZ: 'Tanzania, United Republic of',
      SY: 'Syrian Arab Republic',
      LA: "Lao People's Democratic Republic",
      MD: 'Moldova, Republic of',
      FM: 'Micronesia, Federated States of',
      TW: 'Taiwan, Province of China',
    };
    if (longNames[code]) return longNames[code];
    try {
      return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) || country.name;
    } catch {
      return country.name;
    }
  }

  function countryOptions(selected) {
    const list = [...(Array.isArray(countries) ? countries : [])];
    list.sort((a, b) => {
      if (a.code === 'BO') return -1;
      if (b.code === 'BO') return 1;
      return countryLabel(a).localeCompare(countryLabel(b), 'es');
    });
    return list
      .map((c) => `<option value="${c.code}" ${c.code === selected ? 'selected' : ''}>${countryLabel(c)}</option>`)
      .join('');
  }

  function dialOptions(selected) {
    const list = [...(Array.isArray(countries) ? countries : [])];
    list.sort((a, b) => {
      if (a.code === 'BO') return -1;
      if (b.code === 'BO') return 1;
      return countryLabel(a).localeCompare(countryLabel(b), 'es');
    });
    return list
      .map((c) => `<option value="${c.code}" ${c.code === selected ? 'selected' : ''}>${flagEmoji(c.code)} ${countryLabel(c)} ${c.dial}</option>`)
      .join('');
  }

  function boaDialList() {
    const extras = [{ code: 'AX', name: 'Aland Islands', dial: '+358' }];
    const nanp = {
      AS: '+1684', AI: '+1264', AG: '+1268', BS: '+1242', BB: '+1246', BM: '+1441',
      VG: '+1284', KY: '+1345', DM: '+1767', DO: '+1809', GD: '+1473', GU: '+1671',
      JM: '+1876', MS: '+1664', MP: '+1670', PR: '+1787', KN: '+1869', LC: '+1758',
      SX: '+1721', TT: '+1868', TC: '+1649', VI: '+1340', VC: '+1784',
    };
    const names = { AS: 'AmericanSamoa' };
    const seen = new Set();
    const list = [];
    for (const c of [...extras, ...(Array.isArray(countries) ? countries : [])]) {
      if (!c?.code || seen.has(c.code)) continue;
      seen.add(c.code);
      const name = names[c.code] || c.name;
      const dial = nanp[c.code] || c.dial;
      list.push({ code: c.code, name, dial, label: officialName({ ...c, name }) });
    }
    list.sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
    return list;
  }

  function flagSrc(code) {
    return `/images/boa/flags/${String(code || '').toLowerCase()}.svg`;
  }

  function bindBoaDial(root) {
    const dial = root?.querySelector('[data-boa-dial]');
    if (!dial) return;
    const list = boaDialList();
    const hidden = dial.querySelector('[name="contact-code"]');
    const flag = dial.querySelector('.boa-dial__flag');
    const text = dial.querySelector('.boa-dial__text');
    const search = dial.querySelector('.boa-dial__search');
    const panel = dial.querySelector('.boa-dial__list');
    if (!hidden || !flag || !text || !search || !panel) return;

    function paint(filter) {
      const q = String(filter || '').trim().toLowerCase();
      panel.innerHTML = list
        .filter((c) => !q || `${c.name} ${c.dial} ${c.label} ${c.code}`.toLowerCase().includes(q))
        .map((c) => `<li class="boa-dial__item" role="option" data-code="${c.code}" data-label="${c.label.replace(/"/g, '&quot;')}">
          <img src="${flagSrc(c.code)}" alt="" width="20" height="20">
          <span>${c.name} ${c.dial}</span>
        </li>`)
        .join('');
    }

    function selectCountry(code) {
      const item = list.find((c) => c.code === code) || list[0];
      if (!item) return;
      hidden.value = item.code;
      flag.src = flagSrc(item.code);
      text.textContent = item.label;
      search.value = '';
      close();
    }

    function open() {
      paint(search.value);
      dial.classList.add('is-open');
      panel.hidden = false;
      search.focus();
    }

    function close() {
      dial.classList.remove('is-open');
      panel.hidden = true;
      search.value = '';
    }

    paint('');
    selectDialCountry = selectCountry;
    selectCountry(hidden.value || 'BO');

    dial.querySelector('.boa-dial__control')?.addEventListener('mousedown', (e) => {
      if (e.target === search) return;
      e.preventDefault();
      if (dial.classList.contains('is-open')) close();
      else open();
    });
    search.addEventListener('focus', () => {
      if (!dial.classList.contains('is-open')) open();
    });
    search.addEventListener('input', () => paint(search.value));
    panel.addEventListener('mousedown', (e) => {
      const item = e.target.closest('[data-code]');
      if (!item) return;
      e.preventDefault();
      selectCountry(item.dataset.code);
    });
    document.addEventListener('mousedown', (e) => {
      if (!dial.contains(e.target)) close();
    });
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      if (e.key === 'Enter') {
        e.preventDefault();
        const first = panel.querySelector('[data-code]');
        if (first) selectCountry(first.dataset.code);
      }
    });
  }

  function fieldClass(name) {
    return `av-pax-field` + (name ? ` av-pax-field--${name}` : '');
  }

  function travelerCard(group, index, open) {
    const docs = Array.isArray(documentTypes) ? documentTypes : [];
    const genders = Array.isArray(genderOptions) ? genderOptions : [];
    const contact = index === 0 ? `
      <label class="boa-pax-field">
        <span>Correo electrónico</span>
        <input type="email" name="contact-email" placeholder="Ingresar correo electrónico" autocomplete="email" required>
      </label>
      <div class="boa-phone">
        <div class="boa-pax-field boa-pax-field--dial">
          <span>Celular.</span>
          <div class="boa-dial" data-boa-dial>
            <input type="hidden" name="contact-code" value="BO" required>
            <div class="boa-dial__control">
              <img class="boa-dial__flag" src="/images/boa/flags/bo.svg" alt="" width="20" height="20">
              <span class="boa-dial__text">Bolivia, Plurinational State of</span>
              <input type="text" class="boa-dial__search" autocomplete="off" spellcheck="false" aria-label="Celular">
            </div>
            <ul class="boa-dial__list" hidden role="listbox"></ul>
          </div>
        </div>
        <label class="boa-pax-field boa-pax-field--phone">
          <span class="boa-pax-field__ghost">Número</span>
          <span class="boa-phone__prefix">-</span>
          <input type="tel" name="contact-phone" autocomplete="tel-national" required>
        </label>
      </div>
      <input type="hidden" name="booking-holder" value="0">
      <input type="hidden" name="contact-email-confirm" value="">
      <input type="checkbox" name="contact-privacy" checked hidden>
    ` : '';
    return `
      <article class="boa-pax-card${open ? ' is-open' : ''}" data-pax-card="${index}">
        <button type="button" class="boa-pax-card__head" data-pax-toggle="${index}" aria-expanded="${open ? 'true' : 'false'}">
          <span>
            Pasajero ${index + 1} : ${group.type}
            <i class="av-pax-card__warn" data-pax-warn hidden aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.33333 0C3.73333 0 0 3.73333 0 8.33333C0 12.9333 3.73333 16.6667 8.33333 16.6667C12.9333 16.6667 16.6667 12.9333 16.6667 8.33333C16.6667 3.73333 12.9333 0 8.33333 0ZM9.16667 12.5H7.5V10.8333H9.16667V12.5ZM9.16667 9.16667H7.5V4.16667H9.16667V9.16667Z" fill="#C20000"></path></svg>
            </i>
          </span>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M7.4 10.6 6 12l6 6 6-6-1.4-1.4L12 15.2z"/></svg>
        </button>
        <div class="boa-pax-card__body" ${open ? '' : 'hidden'}>
          <label class="boa-ff">
            <span>Añadir un número de viajero frecuente</span>
            <span class="boa-switch">
              <input type="checkbox" name="p${index}-ff" data-ff-toggle="${index}">
              <i></i>
            </span>
          </label>
          <div class="boa-ff-fields" data-ff-fields="${index}" hidden>
            <label class="boa-pax-field">
              <span>Programa</span>
              <select name="p${index}-ff-program">
                <option value="OB">BoA millas</option>
                <option value="UA">United MileagePlus</option>
                <option value="AC">Aeroplan</option>
              </select>
            </label>
            <label class="boa-pax-field">
              <span>Número</span>
              <input type="text" name="p${index}-ff-number" inputmode="numeric" maxlength="16" placeholder="Número de viajero frecuente">
            </label>
          </div>
          <div class="boa-pax-grid">
            <label class="boa-pax-field">
              <span>Nombres</span>
              <input type="text" name="p${index}-first" placeholder="Ingresar nombres" autocomplete="given-name" required>
              <small>Ingresa tu(s) nombre(s) exactamente como figuran en tu documento de identidad</small>
            </label>
            <label class="boa-pax-field">
              <span>Apellidos</span>
              <input type="text" name="p${index}-last" placeholder="Ingresar apellidos" autocomplete="family-name" required>
              <small>Ingresa tus apellidos exactamente como figura en tu documento de identidad</small>
            </label>
            <label class="boa-pax-field boa-pax-field--dob">
              <span>Fecha de Nacimiento</span>
              <input type="text" name="p${index}-dob" placeholder="DD/MM/YYYY" inputmode="numeric" maxlength="10" autocomplete="bday" required>
              <small>Ingresar fecha de nacimiento</small>
              <input type="hidden" name="p${index}-dob-day">
              <input type="hidden" name="p${index}-dob-month">
              <input type="hidden" name="p${index}-dob-year">
            </label>
            <label class="boa-pax-field">
              <span>Género</span>
              <select name="p${index}-gender" required>
                <option value="" selected disabled>Seleccionar género</option>
                ${genders.map((o) => `<option value="${o.value}">${String(o.label || '').toUpperCase()}</option>`).join('')}
              </select>
            </label>
            <label class="boa-pax-field">
              <span>Tipo de documento de identidad</span>
              <select name="p${index}-doc" required>
                <option value="" selected disabled>Seleccionar tipo de documento de identidad</option>
                ${docs.map((o) => `<option value="${o.value}">${o.label}</option>`).join('')}
              </select>
            </label>
            <label class="boa-pax-field">
              <span>Número de documento de identidad</span>
              <input type="text" name="p${index}-docnum" placeholder="Ingresar número de documento de identidad" required>
            </label>
            ${contact}
          </div>
          <select name="p${index}-nationality" hidden>
            ${countryOptions('BO')}
          </select>
          <p class="av-pax-field__err" data-pax-err="${index}" hidden>Obligatorio</p>
        </div>
      </article>
    `;
  }

  function holderCard(groups) {
    return `
      <article class="av-pax-card" data-holder-card hidden>
        <button type="button" class="av-pax-card__head av-pax-card__head--holder" data-holder-toggle aria-expanded="false">
          <span class="av-pax-card__holder-top">
            <span>
              Titular de la reserva
              <i class="av-pax-card__warn" data-holder-warn hidden aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.33333 0C3.73333 0 0 3.73333 0 8.33333C0 12.9333 3.73333 16.6667 8.33333 16.6667C12.9333 16.6667 16.6667 12.9333 16.6667 8.33333C16.6667 3.73333 12.9333 0 8.33333 0ZM9.16667 12.5H7.5V10.8333H9.16667V12.5ZM9.16667 9.16667H7.5V4.16667H9.16667V9.16667Z" fill="#C20000"></path></svg>
              </i>
            </span>
            <svg class="av-pax-card__chevron" viewBox="0 -960 960 960" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z"/></svg>
          </span>
          <span class="av-pax-card__desc">Será la persona a la cual contactaremos para informarle sobre la reserva y administrar reembolsos.</span>
        </button>
        <div class="av-pax-card__body" data-holder-body hidden>
          <div class="av-pax-grid av-pax-grid--holder">
            <label class="av-pax-field av-pax-field--passenger">
              <span>Pasajero*</span>
              <select name="booking-holder" required>
                ${groups.map((g, i) => `<option value="${i}">${g.label}</option>`).join('')}
              </select>
            </label>
            <div class="av-pax-phone">
              <label class="av-pax-field av-pax-field--dial">
                <span>Prefijo*</span>
                <select name="contact-code" required>
                  <option value="" selected></option>
                  ${dialOptions('')}
                </select>
              </label>
              <label class="av-pax-field av-pax-field--grow">
                <span>Teléfono móvil*</span>
                <input type="tel" name="contact-phone" autocomplete="tel-national" required />
              </label>
            </div>
            <label class="av-pax-field">
              <span>Correo electrónico*</span>
              <input type="email" name="contact-email" autocomplete="email" required />
            </label>
            <label class="av-pax-field">
              <span>Confirma tu correo electrónico*</span>
              <input type="email" name="contact-email-confirm" autocomplete="email" required />
            </label>
          </div>
          <label class="av-pax-legal">
            <input type="checkbox" name="contact-privacy" required />
            <span>Acepto el tratamiento de mis datos personales de conformidad con la <a href="https://www.avianca.com/es/informacion-legal/politica-privacidad/" target="_blank" rel="noopener noreferrer">política de privacidad</a>.</span>
          </label>
          <label class="av-pax-legal av-pax-legal--opt">
            <input type="checkbox" name="contact-marketing" />
            <span>Acepto el uso de mis datos personales para recibir promociones, ofertas y novedades que BoA tiene para mí.</span>
          </label>
        </div>
      </article>
    `;
  }

  function cityName(place, fallback) {
    if (!place) return fallback || '';
    if (typeof place === 'string') return place;
    return place.city || place.code || fallback || '';
  }

  function cityCode(place, fallback) {
    if (!place) return fallback || '';
    if (typeof place === 'string') return fallback || place;
    return place.code || fallback || '';
  }

  function formatSheetDate(iso) {
    if (!iso) return '';
    const d = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(d.getTime())) return iso;
    const day = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'][d.getDay()];
    const month = MONTHS_LONG[d.getMonth()];
    const cap = month.charAt(0).toUpperCase() + month.slice(1);
    return `${day}, ${d.getDate()} ${cap} ${d.getFullYear()}`;
  }

  function fareMeta(fareName) {
    const key = String(fareName || 'Light').toLowerCase();
    return (fareCatalog || []).find((f) => String(f.name || '').toLowerCase() === key || String(f.id || '').toLowerCase() === key)
      || (fareCatalog || [])[0]
      || { name: 'Light', accent: '#ff0000', perks: [] };
  }

  function farePerkIcon(kind, color) {
    const paths = {
      personal: '<path fill-rule="evenodd" clip-rule="evenodd" d="M12.4688 14.4479C13.013 14.4479 13.4583 14.0026 13.4583 13.4583V7.52084C13.4583 6.60052 12.825 5.8336 11.974 5.61094V4.55209H10.4896V5.54167H8.51042V4.55209H7.02604V5.61094C6.175 5.8336 5.54167 6.60052 5.54167 7.52084V13.4583C5.54167 14.0026 5.98698 14.4479 6.53125 14.4479H12.4688ZM6.53125 10.4896V9.5H12.4688V11.4792H11.4792V10.4896H6.53125Z" fill="currentColor"/>',
