  }

  function sheetFareList(fareName) {
    const fare = fareMeta(fareName);
    const accent = fare.accent || '#ff0000';
    return (fare.perks || []).map((perk) => `<li>${farePerkIcon(perk.icon, accent)}<span>${perk.label}</span></li>`).join('');
  }

  function sheetFlight(kind, fromCity, toCity, fromCode, toCode, dateIso, leg) {
    if (!leg?.flight) return '';
    const stopCount = Number(leg.flight.stopCount) || 0;
    const stops = stopCount > 0
      ? (stopCount === 1 ? '1 Parada' : `${stopCount} Paradas`)
      : 'Directo';
    const fare = String(leg.fareName || 'Light');
    return `
      <article class="av-pax-sheet__flight">
        <div class="av-pax-sheet__body">
          <div class="av-pax-sheet__cities">
            <img src="/icons/avianca/takeoff.svg" alt="" width="16" height="16" />
            <p><strong>${kind}</strong> - De ${fromCity} a ${toCity}</p>
          </div>
          <time>${formatSheetDate(dateIso)}</time>
          <div class="av-pax-sheet__seg">
            <div class="av-pax-sheet__end">
              <strong>${leg.flight.depart || ''}</strong>
              <span>${fromCode}</span>
            </div>
            <div class="av-pax-sheet__mid">
              <p class="av-pax-sheet__meta"><span>${stops}</span><i></i><span>${leg.flight.duration || ''}</span></p>
              <div class="av-pax-sheet__line" aria-hidden="true">
                <i></i>
                <svg viewBox="0 0 24 24" width="20" height="20"><path fill="#1b1b1b" d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9L2 14v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5L21 16Z"/></svg>
                <i></i>
              </div>
              <button type="button" class="av-pax-sheet__details">Detalles del vuelo</button>
            </div>
            <div class="av-pax-sheet__end av-pax-sheet__end--right">
              <strong>${leg.flight.arrive || ''}</strong>
              <span>${toCode}</span>
            </div>
          </div>
        </div>
        <div class="av-pax-sheet__farebox">
          <div class="av-pax-sheet__fare">
            <button type="button" class="av-pax-sheet__fare-btn" aria-expanded="false" aria-label="Expand or Collapse ${String(fare).toLowerCase()}">
              <span>Condiciones Tarifa <b>${fare}</b></span>
              <i class="av-pax-sheet__fare-chevron" aria-hidden="true"></i>
            </button>
            <div class="av-pax-sheet__fare-panel">
              <div class="av-pax-sheet__fare-panel-inner">
                <ul class="av-pax-sheet__perks">${sheetFareList(fare)}</ul>
              </div>
            </div>
          </div>
        </div>
      </article>
    `;
  }

  function formatBarDate(iso) {
    if (!iso) return '';
    const d = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(d.getTime())) return iso;
    return `${DAYS_SHORT[d.getDay()]} ${d.getDate()} ${MONTHS_SHORT[d.getMonth()]} ${d.getFullYear()}`;
  }

  function paxCount(selection) {
    return Math.max(1, Number(selection.adults || 1) + Number(selection.children || 0) + Number(selection.infants || 0));
  }

  function tripTotal(selection) {
    const out = ticketAfterDiscount(Number(selection?.outbound?.price || 0));
    const back = ticketAfterDiscount(Number(selection?.inbound?.price || 0));
    return (out + back) * Math.max(1, Number(selection.adults || 1) + Number(selection.children || 0));
  }

  function markInvalid(el, on) {
    const wrap = el?.closest('.boa-pax-field, .av-pax-field, fieldset.av-pax-field');
    wrap?.classList.toggle('is-error', on);
  }

  function syncDob(index) {
    const raw = String(document.querySelector(`[name="p${index}-dob"]`)?.value || '').trim();
    const m = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    const day = m ? String(m[1]).padStart(2, '0') : '';
    const month = m ? String(m[2]).padStart(2, '0') : '';
    const year = m ? m[3] : '';
    const set = (name, value) => {
      const el = document.querySelector(`[name="${name}"]`);
      if (el) el.value = value;
    };
    set(`p${index}-dob-day`, day);
    set(`p${index}-dob-month`, month);
    set(`p${index}-dob-year`, year);
    return Boolean(m);
  }

  function fieldValue(name) {
    return String(document.querySelector(`[name="${name}"]`)?.value || '').trim();
  }

  function toDobInput(value) {
    const raw = String(value || '').trim();
    const slash = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (slash) return `${slash[1].padStart(2, '0')}/${slash[2].padStart(2, '0')}/${slash[3]}`;
    const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1]}`;
    const digits = raw.replace(/\D/g, '');
    if (digits.length === 8) {
      if (Number(digits.slice(0, 4)) > 1900) return `${digits.slice(6, 8)}/${digits.slice(4, 6)}/${digits.slice(0, 4)}`;
      return `${digits.slice(0, 2)}/${digits.slice(2, 4)}/${digits.slice(4, 8)}`;
    }
    return raw;
  }

  function isDob(raw) {
    const m = toDobInput(raw).match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) return false;
    const day = Number(m[1]);
    const month = Number(m[2]);
    const year = Number(m[3]);
    const now = new Date().getFullYear();
    if (month < 1 || month > 12 || day < 1 || day > 31 || year < 1920 || year > now) return false;
    const dt = new Date(year, month - 1, day);
    return dt.getFullYear() === year && dt.getMonth() === month - 1 && dt.getDate() === day;
  }

  function travelerValid(index, show) {
    const first = fieldValue(`p${index}-first`);
    const last = fieldValue(`p${index}-last`);
    const dob = fieldValue(`p${index}-dob`);
    const gender = fieldValue(`p${index}-gender`);
    const doc = fieldValue(`p${index}-doc`);
    const docnum = fieldValue(`p${index}-docnum`);
    const checks = [
      [`p${index}-first`, first.length >= 2],
      [`p${index}-last`, last.length >= 2],
      [`p${index}-dob`, isDob(dob)],
      [`p${index}-gender`, Boolean(gender)],
      [`p${index}-doc`, Boolean(doc)],
      [`p${index}-docnum`, docnum.length >= 4],
    ];
    if (index === 0) {
      const email = fieldValue('contact-email');
      const phone = fieldValue('contact-phone').replace(/\D/g, '');
      const code = fieldValue('contact-code');
      checks.push(['contact-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)]);
      checks.push(['contact-phone', phone.length >= 6]);
      checks.push(['contact-code', Boolean(code)]);
    }
    let ok = true;
    checks.forEach(([name, valid]) => {
      const el = document.querySelector(`[name="${name}"]`);
      if (show) markInvalid(el, !valid);
      if (!valid) ok = false;
    });
    if (!syncDob(index)) {
      ok = false;
      if (show) markInvalid(document.querySelector(`[name="p${index}-dob"]`), true);
    }
    const card = document.querySelector(`[data-pax-card="${index}"]`);
    const warn = card?.querySelector('[data-pax-warn]');
    const err = card?.querySelector('[data-pax-err]');
    if (warn) warn.hidden = ok;
    if (err) err.hidden = ok;
    return ok;
  }

  function holderEmailsMatch() {
    const email = String(document.querySelector('[name="contact-email"]')?.value || '').trim().toLowerCase();
    const confirm = String(document.querySelector('[name="contact-email-confirm"]')?.value || '').trim().toLowerCase();
    return Boolean(email && confirm && email === confirm);
  }

  function syncHolderEmailErrors() {
    const email = document.querySelector('[name="contact-email"]');
    const confirm = document.querySelector('[name="contact-email-confirm"]');
    if (email && String(email.value || '').trim()) markInvalid(email, false);
    if (confirm && String(confirm.value || '').trim()) markInvalid(confirm, !holderEmailsMatch());
  }

  function holderValid(show) {
    const prefix = document.querySelector('[name="contact-code"]');
    const phone = document.querySelector('[name="contact-phone"]');
    const email = document.querySelector('[name="contact-email"]');
    const confirm = document.querySelector('[name="contact-email-confirm"]');
    const privacy = document.querySelector('[name="contact-privacy"]');
    const prefixEmpty = !String(prefix?.value || '').trim();
    const phoneEmpty = !String(phone?.value || '').trim();
    const emailEmpty = !String(email?.value || '').trim();
    const confirmEmpty = !String(confirm?.value || '').trim();
    const mismatch = !holderEmailsMatch();
    if (email && confirm) confirm.value = String(email.value || '').trim();
    if (privacy && !privacy.checked) privacy.checked = true;
    const privacyOff = false;
    const stillMismatch = !holderEmailsMatch();
    if (show) {
      markInvalid(prefix, prefixEmpty);
      markInvalid(phone, phoneEmpty);
      markInvalid(email, emailEmpty);
      markInvalid(confirm, confirmEmpty || stillMismatch);
    }
    const ok = !prefixEmpty && !phoneEmpty && !emailEmpty && !stillMismatch && !privacyOff;
    const warn = document.querySelector('[data-holder-warn]');
    if (warn) warn.hidden = ok;
    return ok;
  }

  function syncHolderPassengers(groups) {
    const select = document.querySelector('select[name="booking-holder"]');
    if (!select) return;
    const current = select.value;
    select.innerHTML = groups.map((g, i) => {
      const first = String(document.querySelector(`[name="p${i}-first"]`)?.value || '').trim();
      const last = String(document.querySelector(`[name="p${i}-last"]`)?.value || '').trim();
      const label = [first, last].filter(Boolean).join(' ') || g.label;
      return `<option value="${i}">${label}</option>`;
    }).join('');
    if ([...select.options].some((o) => o.value === current)) select.value = current;
  }

  function setOpen(card, open) {
    if (!card) return;
    card.classList.toggle('is-open', open);
    const body = card.querySelector('.boa-pax-card__body, .av-pax-card__body');
    const btn = card.querySelector('.boa-pax-card__head, .av-pax-card__head');
    if (body) {
      if (open) body.removeAttribute('hidden');
      else body.setAttribute('hidden', '');
    }
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function renderBar(selection) {
    const fromCode = cityCode(selection.from);
    const toCode = cityCode(selection.to);
    const count = paxCount(selection);
    const legs = document.getElementById('pax-bar-legs');
    const countEl = document.getElementById('pax-bar-count');
    const totalEl = document.getElementById('pax-bar-total');
    if (legs) {
      legs.innerHTML = `
        <div>
          <strong>${fromCode} → ${toCode}</strong>
          <span>${formatBarDate(selection.depart)}</span>
        </div>
        ${selection.trip === 'roundtrip' && selection.returnDate ? `<div>
          <strong>${toCode} → ${fromCode}</strong>
          <span>${formatBarDate(selection.returnDate)}</span>
        </div>` : ''}
      `;
    }
    if (countEl) countEl.textContent = `${count} pasajero${count === 1 ? '' : 's'}`;
    if (totalEl) totalEl.textContent = money(tripTotal(selection));
    const sumBtn = document.getElementById('boa-res-sum-btn');
    if (sumBtn) {
      const n = tripTotal(selection);
      sumBtn.innerHTML = `Resumen de compra USD. ${n.toFixed(2)} <svg viewBox="0 0 12 8" width="10" height="8" aria-hidden="true"><path d="M1 1.4 6 6.4 11 1.4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>`;
    }
    const sumTotal = document.querySelector('#boa-res-sum-menu .boa-res-sum__total strong');
    if (sumTotal) sumTotal.textContent = `USD. ${tripTotal(selection).toFixed(1)}`;
    const drawer = document.getElementById('pax-summary-drawer');
    if (drawer) {
      drawer.innerHTML = `
        ${sheetFlight('Ida', cityName(selection.from), cityName(selection.to), fromCode, toCode, selection.depart, selection.outbound)}
        ${selection.inbound?.flight ? sheetFlight('Vuelta', cityName(selection.to), cityName(selection.from), toCode, fromCode, selection.returnDate, selection.inbound) : ''}
      `;
    }
  }

  function cabinOf(selection) {
    const name = String(selection?.outbound?.fareName || '');
    return /business/i.test(name) ? 'Business' : 'Económica';
  }

  function saveDraft(selection) {
    const people = paxCount(selection);
    const email = fieldValue('contact-email');
    const first = fieldValue('p0-first');
    const last = fieldValue('p0-last');
    const phone = fieldValue('contact-phone');
    const code = fieldValue('contact-code') || 'BO';
    const picked = (Array.isArray(countries) ? countries : []).find((c) => c.code === code);
    const dial = picked?.dial || '+591';
    const cabin = cabinOf(selection);
    const travelers = [];
    for (let i = 0; i < people; i += 1) {
      travelers.push({
        first: fieldValue(`p${i}-first`),
        last: fieldValue(`p${i}-last`),
        dob: toDobInput(fieldValue(`p${i}-dob`)),
        gender: fieldValue(`p${i}-gender`),
        doc: fieldValue(`p${i}-doc`),
        docnum: fieldValue(`p${i}-docnum`),
        email: i === 0 ? email : '',
        phone: i === 0 ? phone : '',
        dial: i === 0 ? dial : '',
        iso: i === 0 ? code : '',
        cabin,
        type: passengerGroups(selection)[i]?.type || 'Adulto',
      });
    }
    sessionStorage.setItem(
      PAX_KEY,
      JSON.stringify({
        savedAt: new Date().toISOString(),
        assistAdded: false,
        assistPrice: 0,
        email,
        firstName: first,
        lastName: last,
        people,
        cabin,
        travelers,
      }),
    );
  }

  function restoreDraft() {
    const draft = readJson(PAX_KEY, {});
    const list = Array.isArray(draft.travelers) ? draft.travelers : [];
    const set = (name, value) => {
      const el = document.querySelector(`[name="${name}"]`);
      if (el && value) el.value = value;
    };
    list.forEach((t, i) => {
      set(`p${i}-first`, t.first);
      set(`p${i}-last`, t.last);
      set(`p${i}-dob`, toDobInput(t.dob));
      set(`p${i}-gender`, t.gender);
      set(`p${i}-doc`, t.doc);
      set(`p${i}-docnum`, t.docnum);
      if (i === 0) {
        set('contact-email', t.email || draft.email);
        set('contact-phone', t.phone);
        const confirm = document.querySelector('[name="contact-email-confirm"]');
        if (confirm) confirm.value = t.email || draft.email || '';
        selectDialCountry(t.iso || 'BO');
      }
      if (t.dob) syncDob(i);
    });
    if (!list.length) {
      set('p0-first', draft.firstName);
      set('p0-last', draft.lastName);
      set('contact-email', draft.email);
    }
  }

  function continueCheckout(selection) {
    const groups = passengerGroups(selection);
    let firstBad = -1;
    groups.forEach((_, i) => {
      if (!travelerValid(i, true) && firstBad < 0) firstBad = i;
    });
    if (firstBad >= 0) {
      groups.forEach((_, i) => setOpen(document.querySelector(`[data-pax-card="${i}"]`), i === firstBad));
      showError('Completa todos los campos obligatorios para continuar.');
      const card = document.querySelector(`[data-pax-card="${firstBad}"]`);
      const invalid = card?.querySelector('.boa-pax-field.is-error input, .boa-pax-field.is-error select, .boa-pax-field.is-error .boa-dial__control');
      (invalid || card)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (invalid && 'focus' in invalid) invalid.focus();
      return;
    }
    showError('');
    saveDraft(selection);
    const search = selection.search || '';
    const qs = search.startsWith('?') ? search : search ? `?${search}` : '';
    window.location.href = `/reserva${qs}`;
  }

  const selection = readJson(STORAGE_KEY, null);
  if (!selection?.outbound) {
    showError('No encontramos tu selección de vuelos. Vuelve a elegir tus tarifas.');
  } else {
    const groups = passengerGroups(selection);
    formsRoot.innerHTML = groups.map((g, i) => travelerCard(g, i, i === 0)).join('');
    bindBoaDial(formsRoot);
    restoreDraft();
    renderBar(selection);

    document.getElementById('pax-alert-close')?.addEventListener('click', () => {
      document.getElementById('pax-alert')?.remove();
    });

    formsRoot.addEventListener('click', (e) => {
      const legalLink = e.target.closest('.av-pax-legal a');
      if (legalLink) {
        e.preventDefault();
        window.open(legalLink.href, '_blank', 'noopener,noreferrer');
        return;
      }
      const toggle = e.target.closest('[data-pax-toggle]');
      if (toggle) {
        const card = document.querySelector(`[data-pax-card="${toggle.dataset.paxToggle}"]`);
        const willOpen = !card?.classList.contains('is-open');
        if (!willOpen) travelerValid(Number(toggle.dataset.paxToggle), false);
        setOpen(card, willOpen);
        return;
      }
      if (e.target.closest('[data-holder-toggle]')) {
        const card = document.querySelector('[data-holder-card]');
        const willOpen = !card?.classList.contains('is-open');
        if (!willOpen) holderValid(false);
        setOpen(card, willOpen);
        return;
      }
      const next = e.target.closest('[data-pax-next]');
      if (next) {
        const idx = Number(next.dataset.paxNext);
        if (!travelerValid(idx, true)) return;
        const card = document.querySelector(`[data-pax-card="${idx}"]`);
        setOpen(card, false);
        const following = document.querySelector(`[data-pax-card="${idx + 1}"]`) || document.querySelector('[data-holder-card]');
        setOpen(following, true);
        following?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        syncHolderPassengers(groups);
      }
    });

    formsRoot.addEventListener('change', (e) => {
      const ff = e.target.closest('[data-ff-toggle]');
      if (ff) {
        const box = document.querySelector(`[data-ff-fields="${ff.dataset.ffToggle}"]`);
        if (box) box.hidden = !ff.checked;
      }
      if (e.target.matches('[name="contact-email"], [name="contact-email-confirm"]')) {
        syncHolderEmailErrors();
      } else {
        const wrap = e.target.closest('.boa-pax-field, .av-pax-field, fieldset.av-pax-field');
        if (wrap && String(e.target.value || '').trim()) wrap.classList.remove('is-error');
      }
      const legal = e.target.closest('.av-pax-legal');
      if (legal && e.target.checked) legal.classList.remove('is-error');
      if (e.target.matches('[name^="p"][name$="-first"], [name^="p"][name$="-last"]')) syncHolderPassengers(groups);
    });

    formsRoot.addEventListener('input', (e) => {
      if (e.target.matches('[name$="-dob"]')) {
        const digits = String(e.target.value || '').replace(/\D/g, '').slice(0, 8);
        const parts = [digits.slice(0, 2), digits.slice(2, 4), digits.slice(4, 8)].filter(Boolean);
        e.target.value = parts.join('/');
        const idx = String(e.target.name || '').match(/^p(\d+)-dob$/);
        if (idx) syncDob(Number(idx[1]));
      }
      if (e.target.matches('[name="contact-email"]')) {
        const confirm = document.querySelector('[name="contact-email-confirm"]');
        if (confirm) confirm.value = e.target.value;
        syncHolderEmailErrors();
      } else if (e.target.matches('[name="contact-email-confirm"]')) {
        syncHolderEmailErrors();
      } else {
        const wrap = e.target.closest('.boa-pax-field, .av-pax-field');
        if (wrap && String(e.target.value || '').trim()) wrap.classList.remove('is-error');
      }
      if (e.target.matches('[name^="p"][name$="-first"], [name^="p"][name$="-last"]')) syncHolderPassengers(groups);
    });

    document.getElementById('pax-summary-drawer')?.addEventListener('click', (e) => {
      const fareBtn = e.target.closest('.av-pax-sheet__fare-btn');
      if (!fareBtn) return;
      e.preventDefault();
      e.stopPropagation();
      const wrap = fareBtn.closest('.av-pax-sheet__fare');
      const open = !wrap?.classList.contains('is-open');
      wrap?.classList.toggle('is-open', open);
      fareBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    document.getElementById('pax-summary-toggle')?.addEventListener('click', () => {
      const drawer = document.getElementById('pax-summary-drawer');
      const btn = document.getElementById('pax-summary-toggle');
      const bg = document.getElementById('pax-sheet-bg');
      const open = drawer?.hidden;
      if (drawer) drawer.hidden = !open;
      if (bg) {
        bg.hidden = !open;
        if (open) bg.removeAttribute('hidden');
        else bg.setAttribute('hidden', '');
      }
      btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.getElementById('pax-bar')?.classList.toggle('is-open', Boolean(open));
    });
    document.getElementById('pax-sheet-bg')?.addEventListener('click', () => {
      document.getElementById('pax-summary-toggle')?.click();
    });

    document.querySelectorAll('[data-pax-continue]').forEach((btn) => {
      btn.addEventListener('click', () => continueCheckout(selection));
    });
    document.getElementById('pax-back')?.addEventListener('click', () => {
      if (window.history.length > 1) window.history.back();
      else window.location.href = `/ofertas-vuelos${selection.search || window.location.search || ''}`;
    });
  }
</script>
