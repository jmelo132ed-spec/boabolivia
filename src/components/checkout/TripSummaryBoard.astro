---
import { PORCENTAJE_DESCUENTO } from 'astro:env/client';
---

<section class="av-trip" id="av-trip">
  <p class="checkout-lead hidden" id="trip-summary-error" hidden></p>
  <div class="av-trip__body" id="trip-summary-content" aria-live="polite"></div>
  <div class="offers-wait-screen hidden" id="trip-wait-screen" hidden role="status" aria-live="polite" aria-label="Cargando">
    <img class="offers-wait-screen__logo" src="/images/boa/logo.png" alt="" width="100" height="100" />
    <p class="offers-wait-screen__text">Cargando...</p>
  </div>
</section>

<script define:vars={{ PORCENTAJE_DESCUENTO }}>
  const STORAGE_KEY = 'latam-checkout-selection';
  const contentRoot = document.getElementById('trip-summary-content');
  const errorBox = document.getElementById('trip-summary-error');
  const DAYS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'Sept', 'oct', 'nov', 'dic'];
  const discountPct = Number(PORCENTAJE_DESCUENTO) || 0;

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.toggle('hidden', !message);
    if (message) errorBox.removeAttribute('hidden');
    else errorBox.setAttribute('hidden', '');
  }

  function money(value) {
    const n = Number(value) || 0;
    const [int, dec] = n.toFixed(2).split('.');
    return `USD ${int.replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${dec}`;
  }

  function ticketAfterDiscount(original) {
    const raw = Math.round((Number(original) || 0) * 100) / 100;
    const tax = Math.round(raw * (233.56 / 1162.56) * 100) / 100;
    const fare = Math.max(0, Math.round((raw - tax) * 100) / 100);
    if (!(discountPct > 0)) return Math.round((fare + tax) * 100) / 100;
    const fareAfter = Math.round(fare * (1 - Math.min(100, discountPct) / 100) * 100) / 100;
    return Math.round((fareAfter + tax) * 100) / 100;
  }

  function readSelection() {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function formatBoundDate(iso) {
    if (!iso) return '';
    const d = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(d.getTime())) return iso;
    return `${DAYS[d.getDay()]}, ${d.getDate()} ${MONTHS[d.getMonth()]}, ${d.getFullYear()}`;
  }

  function fareTone(fareId, fareName) {
    const key = String(fareId || fareName || '').toLowerCase();
    if (key === 'pe' || key.includes('flex')) return 'flex';
    if (key === 'full' || key.includes('classic')) return 'classic';
    if (key.includes('business')) return 'business';
    if (key.includes('light')) return 'light';
    return 'light';
  }

  function fareLabel(fareId, fareName) {
    if (fareName) return fareName;
    const tone = fareTone(fareId, fareName);
    if (tone === 'flex') return 'Flex';
    if (tone === 'classic') return 'Classic';
    if (tone === 'business') return 'Business';
    return 'Light';
  }

  function cityName(place, fallback) {
    if (!place) return fallback || '';
    if (typeof place === 'string') return place;
    return place.city || place.code || fallback || '';
  }

  function cityCode(place, fallback) {
    if (!place) return fallback || '';
    if (typeof place === 'string') return fallback || place;
    return place.code || fallback || '';
  }

  function operatorLine(flight) {
    const raw = flight?.operators || [];
    const names = (raw.length
      ? raw.map((item) => (typeof item === 'string' ? item : item.name))
      : [flight?.airline || 'Boliviana de Aviación']
    ).map((name) => {
      if (/latam|avianca/i.test(name || '')) return 'Boliviana de Aviación';
      if (/taca|t0/i.test(name || '')) return 'Taca International Airlines - Taca';
      return name;
    }).filter(Boolean);
    const unique = [...new Set(names)];
    const label = unique.join(' / ') || 'Boliviana de Aviación';
    return `Incluye vuelo operado por ${label}`;
  }

  function stopsLabel(flight) {
    const n = Number(flight?.stopCount);
    if (Number.isFinite(n)) {
      if (n <= 0) return 'Directo';
      return n === 1 ? '1 Parada' : `${n} Paradas`;
    }
    const raw = String(flight?.stops || 'Directo');
    if (/directo/i.test(raw)) return 'Directo';
    return raw;
  }

  function durationLabel(flight) {
    const n = Number(flight?.durationMinutes);
    if (Number.isFinite(n) && n > 0) {
      const h = Math.floor(n / 60);
      const m = n % 60;
      if (!h) return `${m}m`;
      return m ? `${h}h ${m}m` : `${h}h`;
    }
    return String(flight?.duration || '').replace(/\s*min\.?/g, 'm').replace(/\s*h\s*/, 'h ');
  }

  function clock(value) {
    const match = String(value || '').match(/^(\d{1,2}):(\d{2})/);
    if (!match) return value || '';
    return `${String(match[1]).padStart(2, '0')}:${match[2]}`;
  }

  function planeTakeoff() {
    return `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M2.5 19h19v2h-19V19zm19.57-9.36c-.21-.8-1.04-1.28-1.84-1.06L14.92 10l-6.9-6.43-1.93.51 4.14 7.17-4.97 1.33-1.97-1.54-1.45.39 2.59 4.49L21 11.49c.81-.23 1.28-1.05 1.07-1.85z"/></svg>`;
  }

  function planeLand() {
    return `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M2.5 19h19v2h-19V19zm16.84-3.15c.8.21 1.62-.26 1.84-1.06.21-.8-.26-1.62-1.06-1.84l-5.31-1.42-2.76-9.02L10.12 2v8.28L5.15 8.95l-.93-2.32-1.45-.39v5.17L19.34 15.85z"/></svg>`;
  }

  function planePath() {
    return `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9L2 14v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5L21 16Z"/></svg>`;
  }

  function checkIcon() {
    return `<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="#fff" d="M6.2 11.1 2.8 7.6l1.1-1.1 2.3 2.3 5.1-5.2 1.1 1.1z"/></svg>`;
  }

  function surpriseIcon() {
    return `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#1ea93c"/><path fill="#fff" d="M10.2 16.4 5.8 11.9l1.4-1.4 3 3.1 6.6-6.7 1.4 1.4z"/></svg>`;
  }

  function editIcon() {
    return `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 17.3 16.7 4.6l2.7 2.7L6.7 20H4v-2.7ZM19.8 3.2a1.2 1.2 0 0 0-1.7 0l-1 1 2.7 2.7 1-1a1.2 1.2 0 0 0 0-1.7l-1-1Z"/></svg>`;
  }

  function upsellIcon() {
    return `<svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.2249 2.40015L14.9253 3L14.6624 5.77515L16.5 7.875L14.6624 9.97485L14.9253 12.75L12.2249 13.3499L10.8003 15.75L8.25 14.6624L5.69971 15.75L4.27515 13.3499L1.57471 12.75L1.83765 9.97485L0 7.875L1.83765 5.77515L1.57471 3L4.27515 2.40015L5.69971 0L8.25 1.08765L10.8003 0L12.2249 2.40015ZM8.25 10.125C8.0375 10.125 7.85908 10.1966 7.71533 10.3403C7.57158 10.4841 7.5 10.6625 7.5 10.875C7.5 11.0875 7.57158 11.2659 7.71533 11.4097C7.85908 11.5534 8.0375 11.625 8.25 11.625C8.4625 11.625 8.64092 11.5534 8.78467 11.4097C8.92842 11.2659 9 11.0875 9 10.875C9 10.6625 8.92842 10.4841 8.78467 10.3403C8.64092 10.1966 8.4625 10.125 8.25 10.125ZM7.5 8.625H9V4.125H7.5V8.625Z"/></svg>`;
  }

  function arrowIcon() {
    return `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 4 10.59 5.41 16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>`;
  }

  function upgradeInfo(leg) {
    const tone = fareTone(leg.fareId, leg.fareName);
    const options = Array.isArray(leg.flight?.fareOptions) ? leg.flight.fareOptions : [];
    const findTone = (key) => options.find((item) => item.tone === key || new RegExp(key, 'i').test(item.name || ''));
    let target = null;
    let targetName = '';
    if (tone === 'light') {
      target = findTone('classic');
      targetName = 'Classic';
    } else if (tone === 'classic') {
      target = findTone('flex');
      targetName = 'Flex';
    }
    const current = ticketAfterDiscount(leg.price);
    let next = 0;
    if (target) {
      next = ticketAfterDiscount(Number(target.price || 0) + Number(target.extra || 0));
    } else if (tone === 'light') {
      const base = Number(leg.price) || 0;
      next = ticketAfterDiscount(base + Math.round(14.02 * (base / 91.72) * 100) / 100);
    }
    const delta = Math.round((next - current) * 100) / 100;
    if (!(delta > 0) || !targetName) return null;
    return { name: target?.name || targetName, delta };
  }

  function upsellBlock(upgrade, offersUrl) {
    if (!upgrade) return '';
    const price = money(upgrade.delta);
    return `
      <section class="av-trip-card__upsell">
        <div class="av-trip-card__upsell-copy">
          <span class="av-trip-card__upsell-icon" aria-hidden="true">${upsellIcon()}</span>
          <div>
            <h3 class="av-trip-card__upsell-title av-trip-card__upsell-title--desk">¡Última oportunidad!</h3>
            <p class="av-trip-card__upsell-desc av-trip-card__upsell-desc--desk">Vuela con más equipaje y selección de asiento por solo ${price} más por pasajero.</p>
            <h3 class="av-trip-card__upsell-title av-trip-card__upsell-title--mob">Cambia a ${upgrade.name} por ${price}</h3>
            <p class="av-trip-card__upsell-desc av-trip-card__upsell-desc--mob">Precio por pasajero</p>
          </div>
        </div>
        <a class="av-trip-card__upgrade av-trip-card__upgrade--desk" href="${offersUrl}">Cambiar a ${upgrade.name} ${arrowIcon()}</a>
        <a class="av-trip-card__upgrade av-trip-card__upgrade--mob" href="${offersUrl}" aria-label="Cambiar a ${upgrade.name}">${arrowIcon()}</a>
      </section>
    `;
  }

  function offersHref(selection) {
    const qs = selection.search?.startsWith('?') ? selection.search : `?${selection.search || ''}`;
    return `/ofertas-vuelos${qs}`;
  }

  function seatsHref(selection) {
    const qs = selection.search?.startsWith('?') ? selection.search : `?${selection.search || ''}`;
    return `/pasajeros${qs}`;
  }

  function paxCount(selection) {
    return Math.max(1, Number(selection.adults || 1) + Number(selection.children || 0));
  }

  function boundBlock(kind, fromCity, toCity, dateIso, fromCode, toCode, leg, offersUrl) {
    if (!leg?.flight) return '';
    const next = leg.flight.arriveNextDay ? '<sup>+1</sup>' : '';
    const tone = fareTone(leg.fareId, leg.fareName);
    const title = `${kind === 'inbound' ? 'Vuelta' : 'Ida'}: ${fromCity} a ${toCity}`;
    const dateText = formatBoundDate(dateIso);
    const fareName = fareLabel(leg.fareId, leg.fareName);
    const farePrice = money(ticketAfterDiscount(leg.price));
    const operated = operatorLine(leg.flight);

    return `
      <section class="av-trip-bound">
        <div class="av-trip-bound__title">
          <div class="av-trip-bound__lead">
            ${kind === 'inbound' ? planeLand() : planeTakeoff()}
            <span>${title}</span>
            <i></i>
            <time datetime="${dateIso}">${dateText}</time>
          </div>
          ${kind === 'outbound' ? `<a class="av-trip-bound__edit" href="${offersUrl}">
            ${editIcon()}
            Editar
          </a>` : ''}
        </div>
        <article class="av-trip-card">
          <span class="av-trip-card__check" aria-label="Seleccionado">${checkIcon()}</span>
          <div class="av-trip-card__head">
            <span>${title}</span>
            <time datetime="${dateIso}">${dateText}</time>
          </div>
          <div class="av-trip-card__row">
            <div class="av-trip-card__time">
              <strong>${clock(leg.flight.depart)}</strong>
              <span>${fromCode}</span>
            </div>
            <div class="av-trip-card__path">
              <p>
                <button type="button">${stopsLabel(leg.flight)}</button>
                <i></i>
                <span>${durationLabel(leg.flight)}</span>
              </p>
              <div class="av-trip-card__line" aria-hidden="true">
                <i></i>
                ${planePath()}
                <i></i>
              </div>
              <small>${operated}</small>
            </div>
            <div class="av-trip-card__time av-trip-card__time--in">
              <strong>${clock(leg.flight.arrive)}${next}</strong>
              <span>${toCode}</span>
            </div>
            <div class="av-trip-card__fare">
              <span class="av-trip-fare av-trip-fare--${tone}">${fareName}</span>
              <strong>${farePrice}</strong>
            </div>
          </div>
          <div class="av-trip-card__meta">
            <span>${operated}</span>
            <span class="av-trip-card__meta-fare">
              <b class="av-trip-fare av-trip-fare--${tone}">${fareName}</b>
              <strong>${farePrice}</strong>
            </span>
          </div>
          ${upsellBlock(upgradeInfo(leg), offersUrl)}
        </article>
      </section>
    `;
  }

  function render(selection) {
    if (!contentRoot) return;
    const fromCity = cityName(selection.from);
    const toCity = cityName(selection.to);
    const fromCode = cityCode(selection.from);
    const toCode = cityCode(selection.to);
    const offersUrl = offersHref(selection);
    const nextUrl = seatsHref(selection);
    const perPerson = Number(selection.outbound?.price || 0) + Number(selection.inbound?.price || 0);
    const total = ticketAfterDiscount(perPerson) * paxCount(selection);

    contentRoot.innerHTML = `
      <div class="av-trip__main">
        <div class="av-trip__title">
          <h1>Resumen de viaje</h1>
          <a class="av-trip__edit" href="${offersUrl}">
            ${editIcon()}
            Editar selección
          </a>
        </div>
        ${boundBlock('outbound', fromCity, toCity, selection.depart, fromCode, toCode, selection.outbound, offersUrl)}
        ${selection.trip === 'roundtrip' && selection.inbound
          ? boundBlock('inbound', toCity, fromCity, selection.returnDate, toCode, fromCode, selection.inbound, offersUrl)
          : ''}
        <aside class="av-trip-note" data-trip-note>
          <div class="av-trip-note__top">
            <strong>
              <svg viewBox="0 0 17 17" width="14" height="14" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M8.33333 0C3.73333 0 0 3.73333 0 8.33333C0 12.9333 3.73333 16.6667 8.33333 16.6667C12.9333 16.6667 16.6667 12.9333 16.6667 8.33333C16.6667 3.73333 12.9333 0 8.33333 0ZM9.16667 12.5H7.5V10.8333H9.16667V12.5ZM9.16667 9.16667H7.5V4.16667H9.16667V9.16667Z"/></svg>
              Ten en cuenta
            </strong>
            <button class="av-trip-note__more-btn" type="button" aria-expanded="false">
              <span>Ver más</span>
              <svg viewBox="0 0 12 8" width="9" height="6" aria-hidden="true"><path fill="currentColor" d="M1.2 1.2 6 6l4.8-4.8L12 2.4 6 8 0 2.4z"/></svg>
            </button>
          </div>
          <ul>
            <li>Con las tarifas Basic, Light, Classic y Business Classic los cambios de itinerario tienen un cargo adicional y no se permiten reembolsos.</li>
          </ul>
          <div class="av-trip-note__extra">
            <ul>
              <li>Algunas rutas tienen restricciones en la cantidad de piezas de equipaje en bodega. <a href="https://ayuda.avianca.com/hc/es/articles/13080382443803--D%C3%B3nde-puedo-comprar-equipaje-de-bodega" target="_blank" rel="noopener noreferrer">Consulta</a> las rutas con restricción.</li>
              <li>Para más información puedes consultar las <a href="https://www.avianca.com/es/informacion-y-ayuda/tarifas-avianca/" target="_blank" rel="noopener noreferrer">condiciones de tu tarifa</a>.</li>
            </ul>
          </div>
        </aside>
      </div>
      <footer class="av-trip-bar">
        <div class="av-trip-bar__inner">
          <div class="av-trip-bar__ok">
            ${surpriseIcon()}
            <div>
              <strong>¡Sin sorpresas!</strong>
              <span>Todos los impuestos están incluidos en el precio total</span>
            </div>
          </div>
          <div class="av-trip-bar__total">
            <span>Total de tu reserva:</span>
            <strong>${money(total)}</strong>
          </div>
          <a class="av-trip-bar__cta" href="${nextUrl}">Continuar</a>
        </div>
      </footer>
      <p class="av-trip__copy">© BoA — Boliviana de Aviación 2026</p>
    `;

    const note = contentRoot.querySelector('[data-trip-note]');
    const noteBtn = note?.querySelector('.av-trip-note__more-btn');
    noteBtn?.addEventListener('click', () => {
      const open = note.classList.toggle('is-open');
      noteBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      const label = noteBtn.querySelector('span');
      if (label) label.textContent = open ? 'Ver menos' : 'Ver más';
    });

    contentRoot.querySelector('.av-trip-bar__cta')?.addEventListener('click', (event) => {
      event.preventDefault();
      const href = event.currentTarget.getAttribute('href');
      if (!href) return;
      const wait = document.getElementById('trip-wait-screen');
      wait?.classList.remove('hidden');
      wait?.removeAttribute('hidden');
      document.body.classList.add('is-offers-waiting');
      window.location.href = href;
    });
  }

  const selection = readSelection();
  if (!selection?.outbound) {
    showError('No encontramos tu selección de vuelos. Realiza una búsqueda y elige tus tarifas nuevamente.');
  } else {
    render(selection);
  }
</script>
