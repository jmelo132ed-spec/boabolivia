  document.getElementById('pagos-detail-body')?.addEventListener('click', (event) => {
    const nested = event.target.closest('[data-pagos-nested]');
    if (!nested) return;
    const panel = nested.closest('.pagos-acc')?.querySelector('.pagos-acc__panel');
