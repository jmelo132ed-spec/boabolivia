  const detailToggle = document.getElementById('pagos-detail-toggle');
  const detailPanel = document.getElementById('pagos-detail-panel');
  detailToggle?.addEventListener('click', () => {
    const open = detailToggle.getAttribute('aria-expanded') === 'true';
