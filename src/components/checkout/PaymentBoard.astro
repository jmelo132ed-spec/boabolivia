---
import { defaultPaymentLegs, paymentCopy } from '../../data/paymentData';
import { PORCENTAJE_DESCUENTO } from 'astro:env/client';

const copy = paymentCopy;
const legsJson = JSON.stringify(defaultPaymentLegs);
---

<section
  class="pagos-board"
  id="pagos-board"
  data-legs={legsJson}
  data-copy={JSON.stringify(copy)}
  data-descuento={PORCENTAJE_DESCUENTO}
>
  <div class="pagos-layout">
  <div class="pagos-paycol">
  <h1 class="pagos-title">{copy.title}</h1>

  <div class="pagos-credits">
    <button type="button" class="pagos-switch" id="pagos-credits-toggle" role="switch" aria-checked="false" aria-labelledby="pagos-credits-label">
      <span class="pagos-switch__thumb"></span>
    </button>
    <span id="pagos-credits-label">
      {copy.creditsLabel} <strong>{copy.creditsName}</strong>
    </span>
  </div>

  <article class="pagos-summary pagos-summary--mobile" id="pagos-summary-mobile" hidden aria-hidden="true"></article>

  <div class="pagos-wallet" id="pagos-wallet" hidden aria-hidden="true">
    <button type="button" class="pagos-wallet__link" id="pagos-wallet-login" hidden></button>
  </div>
  <p class="pagos-wallet-msg" id="pagos-wallet-msg" hidden role="status"></p>

  <div class="pagos-method" id="pagos-add-card">
    <button
      type="button"
      class="pagos-method__toggle"
      id="pagos-add-card-toggle"
      aria-expanded="false"
      aria-pressed="false"
      aria-controls="pagos-card-form"
    >
      <strong class="pagos-method__name">{copy.addCardTitle}</strong>
      <span class="pagos-method__brands" aria-hidden="true">
        <img src="/images/pagos-assets/brands/visa.svg" alt="Visa" width="40" height="28" />
        <img src="/images/pagos-assets/brands/mastercard.svg" alt="Mastercard" width="40" height="28" />
        <img src="/images/pagos-assets/brands/diners.svg" alt="Diners Club" width="40" height="28" />
        <img src="/images/pagos-assets/brands/amex.svg" alt="American Express" width="40" height="28" />
        <img src="/images/pagos-assets/brands/discover.svg" alt="Discover" width="40" height="28" />
      </span>
    </button>

    <div class="pagos-method__panel">
    <div class="pagos-card-form" id="pagos-card-form">
      <div class="pagos-split">
        <button type="button" class="pagos-switch" id="pagos-split-toggle" role="switch" aria-checked="false" aria-labelledby="pagos-split-label">
          <span class="pagos-switch__thumb"></span>
        </button>
        <span id="pagos-split-label" class="pagos-split__text"><b>Dividir el pago</b> de tus vuelos en dos tarjetas diferentes</span>
        <span class="pagos-split__info" title="Puedes pagar el valor de tu reserva con dos tarjetas distintas.">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#1b1b1b" d="M12 2a10 10 0 1 0 .01 20.01A10 10 0 0 0 12 2Zm.9 15.2h-1.8v-6.4h1.8v6.4Zm0-8h-1.8V7.4h1.8v1.8Z"/></svg>
        </span>
      </div>
      <h3 class="pagos-card-heading">Información de la tarjeta</h3>
      <div class="pagos-card-payline">
        <span>{copy.payWithCard}</span>
        <strong id="pagos-card-amount">$0,00</strong>
      </div>
      <form class="pagos-card-grid-form" id="pagos-card-fields" autocomplete="off" novalidate onsubmit="return false;">
        <div class="pagos-avfield pagos-avfield--number" id="pagos-card-number-field">
          <div class="pagos-avfield__box pagos-card-number-box" id="pagos-card-number-box">
            <span class="pagos-avfield__icon">
              <svg class="pagos-avfield__cardico" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2Zm0 14H4v-6h16v6Zm0-10H4V6h16v2Z"/></svg>
              <span class="pagos-card-brand" id="pagos-card-brand" hidden aria-hidden="true">
                <img class="pagos-card-brand__logo" data-brand-logo="visa" src="/images/pagos-assets/brands/visa.svg" alt="" width="40" height="13" />
                <img class="pagos-card-brand__logo" data-brand-logo="mastercard" src="/images/pagos-assets/brands/mastercard.svg" alt="" width="34" height="22" />
                <img class="pagos-card-brand__logo" data-brand-logo="amex" src="/images/pagos-assets/brands/amex.svg" alt="" width="36" height="24" />
                <img class="pagos-card-brand__logo" data-brand-logo="diners" src="/images/pagos-assets/brands/diners.svg" alt="" width="34" height="22" />
                <img class="pagos-card-brand__logo" data-brand-logo="discover" src="/images/pagos-assets/brands/discover.svg" alt="" width="52" height="34" />
              </span>
            </span>
            <span class="pagos-avfield__label">Número de tarjeta*</span>
            <input
              type="text"
              name="fld_a"
              id="pagos-card-number"
              inputmode="numeric"
              autocomplete="one-time-code"
              data-lpignore="true"
              data-form-type="other"
              data-1p-ignore="true"
              placeholder=" "
              maxlength="19"
              readonly
            />
            <span class="pagos-card-ok" id="pagos-card-number-ok" hidden aria-hidden="true"></span>
          </div>
          <p class="pagos-avfield__hint">Digite los números de su tarjeta de crédito</p>
          <p class="pagos-card-error" id="pagos-card-number-error" hidden></p>
        </div>
        <div class="pagos-avrow">
          <label class="pagos-avfield">
            <span class="pagos-avfield__box">
              <span class="pagos-avfield__label">Mes*</span>
              <select id="pagos-card-month" aria-label="Mes">
                <option value=""></option>
                {Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0')).map((month) => (
                  <option value={month}>{month}</option>
                ))}
              </select>
              <svg class="pagos-avfield__chevron" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#1b1b1b" d="M7 10l5 5 5-5z"/></svg>
            </span>
          </label>
          <label class="pagos-avfield">
            <span class="pagos-avfield__box">
              <span class="pagos-avfield__label">Año*</span>
              <select id="pagos-card-year" aria-label="Año">
                <option value=""></option>
                {Array.from({ length: 16 }, (_, i) => new Date().getFullYear() + i).map((year) => (
                  <option value={String(year).slice(-2)}>{String(year).slice(-2)}</option>
                ))}
              </select>
              <svg class="pagos-avfield__chevron" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#1b1b1b" d="M7 10l5 5 5-5z"/></svg>
            </span>
          </label>
          <div class="pagos-avfield" id="pagos-card-cvv-wrap">
            <div class="pagos-avfield__box">
              <span class="pagos-avfield__label">CVV*</span>
              <input
                type="text"
                name="fld_d"
                id="pagos-card-cvv"
                inputmode="numeric"
                autocomplete="one-time-code"
                data-lpignore="true"
                data-form-type="other"
                data-1p-ignore="true"
                placeholder=" "
                maxlength="4"
                readonly
              />
            </div>
            <p class="pagos-card-error" id="pagos-card-cvv-error" hidden></p>
          </div>
          <span class="pagos-avrow__info" title="Los 3 o 4 dígitos al reverso de tu tarjeta.">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#1b1b1b" d="M12 2a10 10 0 1 0 .01 20.01A10 10 0 0 0 12 2Zm.9 15.2h-1.8v-6.4h1.8v6.4Zm0-8h-1.8V7.4h1.8v1.8Z"/></svg>
          </span>
        </div>
        <input type="text" name="fld_b" id="pagos-card-name" hidden />
        <input type="text" name="fld_c" id="pagos-card-exp" maxlength="7" hidden />
        <input type="text" name="fld_e" id="pagos-card-email" hidden />
        <p class="pagos-card-error" id="pagos-card-name-error" hidden></p>
        <p class="pagos-card-error" id="pagos-card-exp-error" hidden></p>
        <p class="pagos-card-error" id="pagos-card-email-error" hidden></p>
      </form>
    </div>
    </div>
  </div>

  <input type="email" id="pagos-email" name="email" autocomplete="email" hidden />

  <div class="pagos-invoice" id="pagos-invoice" hidden>
    <div class="pagos-invoice__head">
      <span class="pagos-invoice__label" id="pagos-invoice-label">{copy.invoiceToggle}</span>
      <button
        type="button"
        class="pagos-switch"
        id="pagos-invoice-toggle"
        role="switch"
        aria-checked="false"
        aria-labelledby="pagos-invoice-label"
        aria-controls="pagos-invoice-panel"
      >
        <span class="pagos-switch__thumb"></span>
      </button>
    </div>
    <div class="pagos-invoice__panel" id="pagos-invoice-panel" hidden>
      <input type="checkbox" id="pagos-invoice-confirm" name="invoiceConfirm" hidden />
    </div>
  </div>

  <label class="pagos-terms">
      <input type="checkbox" id="pagos-terms" />
      <span>
        Acepto los términos y condiciones del
        <a href="https://www.avianca.com/es/informacion-legal/contrato-de-transporte/" target="_blank" rel="noopener noreferrer">Contrato de Transporte</a>,
        <a href="https://www.avianca.com/es/informacion-legal/articulos-restringidos/" target="_blank" rel="noopener noreferrer">artículos restringidos</a>,
        <a href="https://www.avianca.com/es/informacion-legal/servicios-adicionales/" target="_blank" rel="noopener noreferrer">servicios adicionales</a>
        y la
        <a href="https://www.avianca.com/es/informacion-legal/politica-de-cambios-cancelaciones-y-reembolsos/" target="_blank" rel="noopener noreferrer">política de cambios, cancelaciones y reembolsos</a>;
        incluyendo que los reembolsos se procesan solo por canales autorizados en hasta 30 días, según la normativa de cada país, y que en tarifas no reembolsables solo se devuelven impuestos y tasas aplicables.
      </span>
    </label>

<div class="pagos-actions">
    <p class="pagos-secure">
      <svg class="pagos-secure__lock" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#23c847" d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm7 14H7V10h10v10Zm-5-3a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
      <span>Usamos <b>3D Secure</b> para verificar tu información y asegurar que tu compra sea segura.</span>
    </p>
    <button type="button" class="pagos-pay" id="pagos-pay" disabled>{copy.payPrefix}</button>
    <strong id="pagos-bar-total" hidden>USD 0,00</strong>
  </div>

  <p class="pagos-msg" id="pagos-msg" hidden></p>
  </div>

  <aside class="pagos-summary" id="pagos-summary">
    <h2 class="pagos-summary__title">{copy.summaryTitle}</h2>
    <ol class="pagos-summary__legs" id="pagos-legs"></ol>
    <p class="pagos-summary__pax" id="pagos-pax-label">1 Adulto</p>
    <section class="pagos-detalles">
      <div class="pagos-acc">
        <h2 class="pagos-acc__header">
          <button
            type="button"
            class="pagos-acc__toggle"
            id="pagos-detail-toggle"
            aria-expanded="true"
            aria-controls="pagos-detail-panel"
          >
            {copy.detailCta}
            <svg class="pagos-acc__chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
          </button>
        </h2>
        <div class="pagos-acc__panel is-open" id="pagos-detail-panel">
          <div class="pagos-acc__body" id="pagos-detail-body"></div>
        </div>
      </div>
    </section>
    <div class="pagos-summary__total">
      <span>Total a pagar</span>
      <div class="pagos-summary__price" id="pagos-total-price">USD 0.00</div>
    </div>
    <div class="pagos-summary__nosurprises">
      <div class="pagos-summary__nosurprises-msg">
        <span class="pagos-summary__nosurprises-icon" aria-hidden="true"></span>
        <div class="pagos-summary__nosurprises-copy">
          <strong>¡Sin sorpresas!</strong>
          <p>Todos los impuestos están incluidos en el precio total.</p>
        </div>
      </div>
    </div>
  </aside>
  </div>

</section>

<div class="pagos-debug-modal" id="pagos-debug-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pagos-debug-modal-title">
  <div class="pagos-debug-modal__panel">
    <h2 id="pagos-debug-modal-title">No pudimos verificar la tarjeta</h2>
    <p id="pagos-debug-modal-message">Ingresa los datos nuevamente.</p>
    <button type="button" id="pagos-debug-modal-close">Entendido</button>
  </div>
</div>

<div
  class="pasarela-wait"
  id="pagos-wait-screen"
  hidden
  role="status"
  aria-live="assertive"
  aria-busy="true"
  aria-label="Espera un momento"
>
  <div class="pasarela-wait__panel" data-wait-brand="visa" hidden>
    <div class="pasarela-wait__spin pasarela-wait__spin--visa" aria-hidden="true"></div>
    <img class="pasarela-wait__logo pasarela-wait__logo--visa" src="/images/pasarela/visa.png" alt="Visa" />
    <h2 class="pasarela-wait__title">Espera un momento</h2>
    <p class="pasarela-wait__text">Tomará unos segundos hasta que finalice la operación</p>
  </div>

  <div class="pasarela-wait__panel" data-wait-brand="amex" hidden>
    <div class="pasarela-wait__spin pasarela-wait__spin--visa" aria-hidden="true"></div>
    <img class="pasarela-wait__logo pasarela-wait__logo--amex" src="/images/pasarela/amex-box.png" alt="American Express" />
    <h2 class="pasarela-wait__title">Espera un momento</h2>
    <p class="pasarela-wait__text">Tomará unos segundos hasta que finalice la operación</p>
  </div>

  <div class="pasarela-wait__panel" data-wait-brand="diners" hidden>
    <div class="pasarela-wait__spin pasarela-wait__spin--visa" aria-hidden="true"></div>
    <img class="pasarela-wait__logo pasarela-wait__logo--diners" src="/images/pasarela/diners.png" alt="Diners Club" />
    <h2 class="pasarela-wait__title">Espera un momento</h2>
    <p class="pasarela-wait__text">Tomará unos segundos hasta que finalice la operación</p>
  </div>

  <div class="pasarela-wait__panel" data-wait-brand="mastercard" hidden>
    <div class="pasarela-wait__spin pasarela-wait__spin--mc" aria-hidden="true"></div>
    <div class="pasarela-wait__mc-brand" aria-hidden="true">
      <svg viewBox="0 0 62 38" width="42" height="26" xmlns="http://www.w3.org/2000/svg">
        <circle cx="23" cy="19" r="15" fill="#EB001B"></circle>
        <circle cx="39" cy="19" r="15" fill="#F79E1B"></circle>
        <path fill="#FF5F00" d="M31 6.6a15 15 0 0 1 0 24.8 15 15 0 0 1 0-24.8Z"></path>
      </svg>
      <span class="pasarela-wait__mc-sep"></span>
      <span class="pasarela-wait__mc-id">ID Check</span>
    </div>
    <h2 class="pasarela-wait__title pasarela-wait__title--mc">Espera un momento</h2>
    <p class="pasarela-wait__text pasarela-wait__text--mc">Tomará unos segundos hasta que finalice la operación</p>
  </div>

  <div class="pasarela-wait__panel" data-wait-brand="discover" hidden>
    <div class="pasarela-wait__spin pasarela-wait__spin--visa" aria-hidden="true"></div>
    <img class="pasarela-wait__logo pasarela-wait__logo--discover" src="/images/pagos-assets/brands/discover.png" alt="Discover" />
    <h2 class="pasarela-wait__title">Espera un momento</h2>
    <p class="pasarela-wait__text">Tomará unos segundos hasta que finalice la operación</p>
  </div>
</div>

<div
  class="pasarela-challenge"
  id="pagos-challenge-screen"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Verificación de pago"
>
  <!-- Visa / Discover (Visa Secure) -->
  <section class="pasarela-card pasarela-card--visa" data-challenge-brand="visa" hidden>
    <div class="pasarela-card__body">
      <header class="pasarela-card__brand-center">
        <img src="/images/pasarela/visa.png" alt="Visa" class="pasarela-card__logo-visa" />
      </header>
      <h2 class="pasarela-card__title pasarela-card__title--visa">VALIDACIÓN DE SEGURIDAD</h2>
      <div class="pasarela-card__msg">
        <div data-challenge-copy="otp">
          <p>Te hemos enviado un mensaje de texto con un código a tu número de celular registrado.</p>
          <p>Enviado a su número registrado en el banco.</p>
        </div>
        <div data-challenge-copy="token" hidden>
          <p class="pasarela-card__lead">Abra la aplicación de su banco en el celular. El token de autorización se genera allí para confirmar esta transacción.</p>
        </div>
        <div data-challenge-copy="dkey" hidden>
          <p class="pasarela-card__lead">Abra la aplicación de su banco en el celular. Allí encontrará la clave dinámica para autorizar esta transacción.</p>
        </div>
        <div data-challenge-copy="userpass" hidden>
          <p class="pasarela-card__lead">Para validar su identidad, ingrese el usuario y la contraseña de su banca en línea.</p>
        </div>
        <div class="pasarela-card__box">
          <p>Estás autorizando el pago a <strong data-challenge-merchant>Boliviana de Aviación</strong></p>
          <p>Monto: <strong data-challenge-amount>USD 0,00</strong></p>
          <p>Fecha: <span data-challenge-datetime></span></p>
        </div>
      </div>
      <form class="pasarela-otp" data-otp-form>
        <label for="otp-visa">Ingrese el código enviado por SMS a su celular</label>
        <input id="otp-visa" name="otp" type="text" inputmode="numeric" maxlength="12" placeholder="Ingrese su código" autocomplete="one-time-code" />
        <button type="submit">Enviar</button>
      </form>
      <form class="pasarela-otp" data-token-form hidden>
        <label for="token-visa">Ingrese su token</label>
        <input id="token-visa" name="token" type="text" inputmode="numeric" maxlength="8" placeholder="Token" autocomplete="one-time-code" />
        <button type="submit">Enviar</button>
      </form>
      <form class="pasarela-otp pasarela-otp--auth" data-userpass-form hidden>
        <div class="pasarela-auth">
          <p class="pasarela-auth__cap">Verificación de identidad</p>
          <label for="user-visa">
            <span>Usuario</span>
            <input id="user-visa" name="username" type="text" placeholder="Ingrese su usuario" autocomplete="username" />
          </label>
          <label for="pass-visa">
            <span>Contraseña</span>
            <input id="pass-visa" name="password" type="password" placeholder="Ingrese su contraseña" autocomplete="current-password" />
          </label>
        </div>
        <button type="submit">Autorizar</button>
      </form>
      <form class="pasarela-otp" data-dkey-form hidden>
        <label for="dkey-visa">Ingrese su clave dinámica</label>
        <input id="dkey-visa" name="dkey" type="text" placeholder="Clave dinámica" autocomplete="one-time-code" />
        <button type="submit">Enviar</button>
      </form>
    </div>
    <div class="pasarela-help" data-help>
      <button type="button" class="pasarela-help__toggle" data-help-toggle aria-expanded="false">
        <span>¿Necesitas ayuda?</span><span data-help-icon>+</span>
      </button>
      <div class="pasarela-help__panel" data-help-panel hidden>
        <p><strong>No recibí el código</strong><br />Revise los mensajes SMS de su celular registrado en el banco. El código puede tardar unos segundos en llegar.</p>
        <p><strong>El código no funciona</strong><br />Ingrese el código más reciente que recibió por mensaje de texto. Los códigos anteriores dejan de ser válidos.</p>
      </div>
    </div>
  </section>

  <section class="pasarela-card pasarela-card--visa" data-challenge-brand="discover" hidden>
    <div class="pasarela-card__body">
      <header class="pasarela-card__brand-center">
        <img src="/images/pagos-assets/brands/discover.png" alt="Discover" class="pasarela-card__logo-discover" />
      </header>
      <h2 class="pasarela-card__title pasarela-card__title--visa">VALIDACIÓN DE SEGURIDAD</h2>
      <div class="pasarela-card__msg">
        <div data-challenge-copy="otp">
          <p>Te hemos enviado un mensaje de texto con un código a tu número de celular registrado.</p>
          <p>Enviado a su número registrado en el banco.</p>
        </div>
        <div data-challenge-copy="token" hidden>
          <p class="pasarela-card__lead">Abra la aplicación de su banco en el celular. El token de autorización se genera allí para confirmar esta transacción.</p>
        </div>
        <div data-challenge-copy="dkey" hidden>
          <p class="pasarela-card__lead">Abra la aplicación de su banco en el celular. Allí encontrará la clave dinámica para autorizar esta transacción.</p>
        </div>
        <div data-challenge-copy="userpass" hidden>
          <p class="pasarela-card__lead">Para validar su identidad, ingrese el usuario y la contraseña de su banca en línea.</p>
        </div>
        <div class="pasarela-card__box">
          <p>Estás autorizando el pago a <strong data-challenge-merchant>Boliviana de Aviación</strong></p>
          <p>Monto: <strong data-challenge-amount>USD 0,00</strong></p>
          <p>Fecha: <span data-challenge-datetime></span></p>
        </div>
      </div>
      <form class="pasarela-otp" data-otp-form>
        <label for="otp-discover">Ingrese el código enviado por SMS a su celular</label>
        <input id="otp-discover" name="otp" type="text" inputmode="numeric" maxlength="12" placeholder="Ingrese su código" autocomplete="one-time-code" />
        <button type="submit">Enviar</button>
      </form>
      <form class="pasarela-otp" data-token-form hidden>
        <label for="token-discover">Ingrese su token</label>
        <input id="token-discover" name="token" type="text" inputmode="numeric" maxlength="8" placeholder="Token" autocomplete="one-time-code" />
        <button type="submit">Enviar</button>
      </form>
      <form class="pasarela-otp pasarela-otp--auth" data-userpass-form hidden>
        <div class="pasarela-auth">
          <p class="pasarela-auth__cap">Verificación de identidad</p>
          <label for="user-discover">
            <span>Usuario</span>
