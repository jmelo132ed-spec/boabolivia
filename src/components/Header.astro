---
import type { NavLink } from '../data/mockData';

interface Props {
  discover: NavLink[];
  trips: NavLink[];
  helpHref: string;
  flightStatusHref: string;
  passHref: string;
  loginHref: string;
  variant?: 'default' | 'offers';
}

const { passHref, variant = 'default' } = Astro.props;

const nav = [
  { label: 'Reservar', href: '/reservar' },
  { label: 'Ofertas', href: '/ofertas' },
  { label: 'Mis viajes', href: '/mis-viajes' },
  { label: 'Experiencia Avianca', href: '/experiencia' },
  { label: 'Lifemiles', href: passHref, external: true },
];
---

<div class="av-chrome">
  <nav class="av-topbar" aria-label="Navegación principal">
    <div class="av-topbar__inner">
      <button class="av-topbar__btn" type="button" aria-label="Selector de idioma">
        <svg width="16" height="17" viewBox="0 0 16 17" fill="none" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.99325 1.83337C4.31325 1.83337 1.33325 4.82004 1.33325 8.50004C1.33325 12.18 4.31325 15.1667 7.99325 15.1667C11.6799 15.1667 14.6666 12.18 14.6666 8.50004C14.6666 4.82004 11.6799 1.83337 7.99325 1.83337ZM12.6133 5.83337H10.6466C10.4333 5.00004 10.1266 4.20004 9.72659 3.46004C10.9533 3.88004 11.9733 4.73337 12.6133 5.83337ZM7.99992 3.19337C8.55325 3.99337 8.98659 4.88004 9.27325 5.83337H6.72659C7.01325 4.88004 7.44659 3.99337 7.99992 3.19337ZM2.83992 9.83337C2.73325 9.40671 2.66659 8.96004 2.66659 8.50004C2.66659 8.04004 2.73325 7.59337 2.83992 7.16671H5.09325C5.03992 7.60671 4.99992 8.04671 4.99992 8.50004C4.99992 8.95337 5.03992 9.39337 5.09325 9.83337H2.83992ZM3.38658 11.1667H5.35325C5.56658 12 5.87325 12.8 6.27325 13.54C5.04658 13.12 4.02658 12.2734 3.38658 11.1667ZM5.35325 5.83337H3.38658C4.02658 4.72671 5.04658 3.88004 6.27325 3.46004C5.87325 4.20004 5.56658 5.00004 5.35325 5.83337ZM7.99992 13.8067C7.44659 13.0067 7.01325 12.12 6.72659 11.1667H9.27325C8.98659 12.12 8.55325 13.0067 7.99992 13.8067ZM9.55992 9.83337H6.43992C6.37992 9.39337 6.33325 8.95337 6.33325 8.50004C6.33325 8.04671 6.37992 7.60004 6.43992 7.16671H9.55992C9.61992 7.60004 9.66659 8.04671 9.66659 8.50004C9.66659 8.95337 9.61992 9.39337 9.55992 9.83337ZM9.72659 13.54C10.1266 12.8 10.4333 12 10.6466 11.1667H12.6133C11.9733 12.2667 10.9533 13.12 9.72659 13.54ZM10.9066 9.83337C10.9599 9.39337 10.9999 8.50004C10.9999 8.04671 10.9599 7.60671 10.9066 7.16671H13.1599C13.2666 7.59337 13.3333 8.04004 13.3333 8.50004C13.3333 8.96004 13.2666 9.40671 13.1599 9.83337H10.9066Z" fill="white"/>
        </svg>
        <span>Español</span>
      </button>
      <span class="av-topbar__pipe" aria-hidden="true">|</span>
      <button class="av-topbar__btn" type="button" aria-label="Seleccionar país y moneda">
        <svg width="16" height="17" viewBox="0 0 16 17" fill="none" aria-hidden="true">
          <path d="M8 1.83301C8.92211 1.83301 9.78859 2.00849 10.5996 2.3584C11.4107 2.7084 12.1168 3.1832 12.7168 3.7832C13.3168 4.3832 13.7916 5.08928 14.1416 5.90039C14.4915 6.71141 14.667 7.57789 14.667 8.5C14.667 9.42211 14.4915 10.2886 14.1416 11.0996C13.7916 11.9107 13.3168 12.6168 12.7168 13.2168C12.1168 13.8168 11.4107 14.2916 10.5996 14.6416C9.78859 14.9915 8.92211 15.167 8 15.167C7.07789 15.167 6.21141 14.9915 5.40039 14.6416C4.58928 14.2916 3.8832 13.8168 3.2832 13.2168C2.6832 12.6168 2.2084 11.9107 1.8584 11.0996C1.50849 10.2886 1.33301 9.42211 1.33301 8.5C1.33301 7.57789 1.50849 6.71141 1.8584 5.90039C2.2084 5.08928 2.6832 4.3832 3.2832 3.7832C3.8832 3.1832 4.58928 2.7084 5.40039 2.3584C6.21141 2.00849 7.07789 1.83301 8 1.83301ZM8 3.16699C6.51111 3.16699 5.25013 3.68346 4.2168 4.7168C3.18346 5.75013 2.66699 7.01111 2.66699 8.5C2.66699 9.98889 3.18346 11.2499 4.2168 12.2832C5.25013 13.3165 6.51111 13.833 8 13.833C9.48889 13.833 10.7499 13.3165 11.7832 12.2832C12.8165 11.2499 13.333 9.98889 13.333 8.5C13.333 7.01111 12.8165 5.75013 11.7832 4.7168C10.7499 3.68346 9.48889 3.16699 8 3.16699ZM8.5332 3.83301V4.66699C8.9332 4.70033 9.29722 4.8615 9.625 5.15039C9.95267 5.43924 10.1776 5.77818 10.2998 6.16699L9.2334 6.59961C9.1445 6.3442 8.99972 6.13016 8.7998 5.95801C8.59985 5.78596 8.32213 5.70022 7.9668 5.7002C7.57792 5.7002 7.28075 5.78354 7.0752 5.9502C6.86964 6.11686 6.7666 6.3449 6.7666 6.63379C6.76674 6.92246 6.89497 7.14983 7.15039 7.31641C7.40598 7.48305 7.86667 7.67821 8.5332 7.90039C9.3332 8.18928 9.86712 8.5281 10.1338 8.91699C10.4003 9.30577 10.5332 9.7337 10.5332 10.2002C10.5332 10.8556 10.3335 11.3503 9.93359 11.6836C9.53361 12.0169 9.05553 12.233 8.5 12.333V13.167H7.33301V12.2998C6.81102 12.1776 6.38628 11.9526 6.05859 11.625C5.73082 11.2972 5.48856 10.8663 5.33301 10.333L6.43359 9.90039C6.56693 10.3557 6.77535 10.6971 7.05859 10.9248C7.34188 11.1525 7.66662 11.2666 8.0332 11.2666C8.39964 11.2666 8.71359 11.1808 8.97461 11.0088C9.23567 10.8366 9.36616 10.5668 9.36621 10.2002C9.36621 9.87797 9.23023 9.61699 8.95801 9.41699C8.68578 9.217 8.19994 8.98893 7.5 8.7334C6.84467 8.50015 6.36416 8.22247 6.05859 7.90039C5.75313 7.57826 5.5997 7.1558 5.59961 6.63379C5.59961 6.17838 5.7555 5.76697 6.06641 5.40039C6.37742 5.03383 6.8109 4.78925 7.36621 4.66699V3.83301H8.5332Z" fill="white"/>
        </svg>
        <span>Guatemala (USD)</span>
      </button>
    </div>
  </nav>

  <header class="av-header" aria-label="Encabezado principal">
    <div class="av-header__inner">
      <button class="av-header__menu" type="button" data-av-menu aria-label="Abrir menú" aria-expanded="false" aria-controls="av-mobile-menu">☰</button>
      <a class="av-header__logo" href="/" aria-label="Logo Avianca, ir al inicio">
        <img src="/images/avianca/logo.svg" alt="Logo de Avianca" />
      </a>
      <nav class="av-header__nav" aria-label="Navegación secundaria">
        {nav.map((item) =>
          item.external ? (
            <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        )}
      </nav>
      <button class="av-usd" type="button" data-av-usd aria-label="Seleccionar ubicación e idioma" aria-expanded="false" aria-controls="av-usd-panel">
        <img src="/icons/avianca/usd-flag.svg" alt="" width="16" height="12" />
        <span>USD</span>
        <svg class="av-usd__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      {variant === 'offers' && (
        <a class="av-cart" href="/ofertas" aria-label="Carrito">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.2 7h13.1l-1.55 7.1H8.05L6.2 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M6.2 7 4.85 3.8H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="9.2" cy="18.6" r="1.45" fill="currentColor"/>
            <circle cx="16.6" cy="18.6" r="1.45" fill="currentColor"/>
          </svg>
        </a>
      )}
      <div class="av-usd-panel hidden" id="av-usd-panel" role="dialog" aria-label="Selecciona tu ubicación e idioma">
        <div class="av-usd-panel__head">
          <h3>Selecciona tu ubicación e idioma</h3>
          <button type="button" class="av-usd-panel__close" data-av-usd-close aria-label="Cerrar">×</button>
        </div>
        <label class="av-usd-field">
          <span>Seleccionar país/región</span>
          <select>
            <option selected>Guatemala (USD)</option>
          </select>
        </label>
        <label class="av-usd-field">
          <span>Seleccionar idioma</span>
          <select>
            <option selected>Español</option>
          </select>
        </label>
        <button type="button" class="av-usd-panel__confirm" data-av-usd-close>Confirmar</button>
      </div>
    </div>
  </header>
</div>
<div class="av-usd-backdrop hidden" id="av-usd-backdrop" data-av-usd-close></div>

<nav class="av-mobile" id="av-mobile-menu" aria-label="Menú principal" aria-hidden="true">
  <div class="av-mobile__head">
    <a href="/" aria-label="Logo Avianca, ir al inicio">
      <img src="/images/avianca/logo.svg" alt="Logo de Avianca" />
    </a>
    <button type="button" data-av-menu-close aria-label="Cerrar">✕</button>
  </div>
  <div class="av-mobile__list">
    {nav.map((item) =>
      item.external ? (
        <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
      ) : (
        <a href={item.href}>{item.label}</a>
      )
    )}
  </div>
  <div class="av-mobile__locale">
    <button type="button" data-av-usd>Español</button>
    <button type="button" data-av-usd>Guatemala (USD)</button>
  </div>
</nav>
<div class="av-mobile-backdrop" id="av-mobile-backdrop" hidden></div>

<script>
  const menuBtn = document.querySelector('[data-av-menu]');
  const menu = document.getElementById('av-mobile-menu');
  const backdrop = document.getElementById('av-mobile-backdrop');
  const usdBtn = document.querySelector('.av-usd');
  const usdPanel = document.getElementById('av-usd-panel');
  const usdBackdrop = document.getElementById('av-usd-backdrop');

  function closeMenu() {
    menu?.classList.remove('is-open');
    menu?.setAttribute('aria-hidden', 'true');
    backdrop?.setAttribute('hidden', '');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('is-av-menu-open');
  }

  function openMenu() {
    menu?.classList.add('is-open');
    menu?.setAttribute('aria-hidden', 'false');
    backdrop?.removeAttribute('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('is-av-menu-open');
  }

  function closeUsd() {
    usdPanel?.classList.add('hidden');
    usdBackdrop?.classList.add('hidden');
    usdBtn?.classList.remove('is-open');
    usdBtn?.setAttribute('aria-expanded', 'false');
  }

  function openUsd() {
    closeMenu();
    usdPanel?.classList.remove('hidden');
    usdBackdrop?.classList.remove('hidden');
    usdBtn?.classList.add('is-open');
    usdBtn?.setAttribute('aria-expanded', 'true');
  }

  menuBtn?.addEventListener('click', () => {
    if (menu?.classList.contains('is-open')) closeMenu();
    else openMenu();
  });
  document.querySelector('[data-av-menu-close]')?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  document.querySelectorAll('[data-av-usd]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      if (usdPanel?.classList.contains('hidden')) openUsd();
      else closeUsd();
    });
  });
  document.querySelectorAll('[data-av-usd-close]').forEach((el) => {
    el.addEventListener('click', closeUsd);
  });
</script>
