---
interface Link { label: string; href: string; external?: boolean }
interface Col { title: string; links: Link[] }
interface Social { label: string; href: string; color: string }
interface Props {
  columns: Col[];
  socials: Social[];
  variant?: 'simple' | 'full';
}
const { variant = 'simple' } = Astro.props;

const fullCols = [
  {
    title: 'Lifemiles',
    links: [
      { label: 'Programa Lifemiles', href: 'https://www.avianca.com/es/lifemiles' },
      { label: 'Millas pendientes', href: 'https://www.avianca.com/es/lifemiles/millas-pendientes' },
      { label: 'Lifemiles Plus', href: 'https://www.lifemiles.com/landing/lifemiles+' },
      { label: 'Acumula millas', href: 'https://www.avianca.com/es/lifemiles' },
      { label: 'Tarjetas de crédito Lifemiles', href: 'https://www.avianca.com/es/lifemiles' },
      { label: 'Dona millas', href: 'https://www.avianca.com/es/lifemiles' },
    ],
  },
  {
    title: 'Sobre nosotros',
    links: [
      { label: 'Somos Avianca', href: 'https://www.avianca.com/es/sobre-nosotros' },
      { label: 'Contáctanos', href: 'https://www.avianca.com/es/contacto' },
      { label: 'Noticias corporativas', href: 'https://www.avianca.com/es/noticias' },
      { label: 'Alianzas y beneficios', href: 'https://www.avianca.com/es/alianzas' },
      { label: 'Sostenibilidad', href: 'https://www.avianca.com/es/sostenibilidad' },
      { label: 'Plan de accesibilidad', href: 'https://www.avianca.com/es/accesibilidad' },
    ],
  },
  {
    title: 'Nuestros portales',
    links: [
      { label: 'Avianca empresas', href: 'https://www.avianca.com/es/empresas' },
      { label: 'Aviancadirect', href: 'https://www.avianca.com/es/aviancadirect' },
      { label: 'Soporte agencias', href: 'https://www.avianca.com/es/agencias' },
      { label: 'Avianca cargo', href: 'https://www.avianca.com/es/cargo' },
      { label: 'Relación con inversionistas', href: 'https://www.avianca.com/es/inversionistas' },
      { label: 'Trabaja con nosotros', href: 'https://www.avianca.com/es/empleos' },
    ],
  },
  {
    title: 'Enlaces rápidos',
    links: [
      { label: 'Información legal', href: '/legal/terminos' },
      { label: 'Política de privacidad', href: '/legal/privacidad' },
      { label: 'Contrato de transporte', href: '/legal/contrato' },
      { label: 'Artículos restringidos', href: 'https://www.avianca.com/es/articulos-restringidos' },
      { label: 'Plan de contingencia', href: 'https://www.avianca.com/es/contingencia' },
      { label: 'Factura electrónica', href: 'https://www.avianca.com/es/factura' },
    ],
  },
];
---

{variant === 'full' ? (
  <footer class="av-footer av-footer--full">
    <div class="av-footer__grid">
      {fullCols.map((col) => (
        <div>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
                  {l.label}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 3h9v9H11.5V5.56L4.53 12.53 3.47 11.47 10.44 4.5H4V3Z" fill="currentColor"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="av-footer__copy">Copyright @ Avianca 2026</p>
  </footer>
) : (
  <footer class="av-footer">
    <p class="av-footer__copy">Copyright © avianca 2026</p>
  </footer>
)}
