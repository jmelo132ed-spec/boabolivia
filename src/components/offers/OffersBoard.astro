---
import { PORCENTAJE_DESCUENTO } from 'astro:env/client';

interface Props {
  trip: string;
  search?: string;
  fromCity?: string;
  toCity?: string;
  origin?: string;
  destination?: string;
  depart?: string;
  returnDate?: string;
  fromAirport?: string;
  toAirport?: string;
}

const {
  trip,
  search = '',
  fromCity = '',
  toCity = '',
  origin = '',
  destination = '',
  depart = '',
  fromAirport = '',
  toAirport = '',
} = Astro.props;
---

<section class="offers-board av-book-board boa-offers">
  <header class="boa-banner">
    <div class="boa-banner__copy">
      <h1 class="offers-title" id="offers-title">Selecciona tu vuelo de ida</h1>
      <p class="boa-banner__sub" id="offers-title-date"></p>
    </div>
    <button class="av-book-heading__dates" type="button" id="av-dates-toggle" hidden></button>
  </header>
  <div class="boa-dates" id="av-book-dates"></div>
  <div class="boa-sort av-book-filters">
    <span>Ordenar por:</span>
    <button type="button" data-sort="recommended" aria-selected="true">Más relevante</button>
    <button type="button" data-sort="cheapest" aria-selected="false">Precio</button>
    <button type="button" data-sort="depart-asc" aria-selected="false">Horario de salida</button>
    <button type="button" data-sort="fastest" aria-selected="false">Duración</button>
    <span id="sort-label" hidden>Más relevante</span>
  </div>

  <div class="offers-timeout hidden" id="offers-timeout" hidden>
    <img src="/images/boa/logo.png" alt="" width="100" height="100" />
    <h1>La búsqueda está tardando más de lo normal</h1>
    <p>Tuvimos un problema con los resultados. Inténtalo nuevamente.</p>
    <a class="offers-timeout__btn" href="/reservar">Realizar otra búsqueda</a>
  </div>

  <p class="offers-error hidden" id="offers-error" hidden></p>
  <p class="offers-empty hidden" id="offers-empty" hidden>
    {search ? 'No hay vuelos para esta búsqueda. Prueba otras fechas u otra ruta.' : 'Completa origen y destino en el buscador para ver vuelos disponibles.'}
  </p>
  <div class="offers-list" id="offers-list"></div>
  <details class="av-book-terms">
    <summary>
      <svg class="av-book-terms__ico" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M2 3h12v1.4H2V3Zm0 4.3h12v1.4H2V7.3Zm0 4.3h12V13H2v-1.4Z"/></svg>
      <span>Condiciones tarifarias</span>
      <svg class="av-book-terms__chev" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
    </summary>
    <ul>
      <li>Los precios incluyen tasas e impuestos y están sujetos a confirmación al emitir.</li>
      <li>Las tarifas Light, Classic y Flex tienen cupos limitados.</li>
      <li>Puedes acumular millas BoA en trayectos operados por Boliviana de Aviación.</li>
      <li>Revisa equipaje y requisitos de viaje según el destino.</li>
    </ul>
  </details>
</section>

<div class="itinerary-drawer" id="itinerary-drawer" hidden>
  <div class="itinerary-drawer__backdrop" data-close-itinerary></div>
  <aside class="itinerary-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="itinerary-title">
    <header class="itinerary-drawer__head">
      <h2 id="itinerary-title">Itinerario de vuelo</h2>
      <button type="button" class="itinerary-drawer__close" data-close-itinerary aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M25.657 8.343 17.999 16l7.658 7.657-2.343 2.343L15.656 18.343 8 25.999l-2.343-2.343L13.314 16 5.657 8.343 8 6l7.656 7.657L23.314 6l2.343 2.343Z"/>
        </svg>
      </button>
    </header>
    <div class="itinerary-drawer__body" id="itinerary-body"></div>
  </aside>
</div>

<div class="itinerary-drawer" id="fare-drawer" hidden>
  <div class="itinerary-drawer__backdrop" data-close-fare></div>
  <aside class="itinerary-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="fare-title">
    <header class="itinerary-drawer__head">
      <h2 id="fare-title">Detalle tarifa</h2>
      <button type="button" class="itinerary-drawer__close" data-close-fare aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M25.657 8.343 17.999 16l7.658 7.657-2.343 2.343L15.656 18.343 8 25.999l-2.343-2.343L13.314 16 5.657 8.343 8 6l7.656 7.657L23.314 6l2.343 2.343Z"/>
        </svg>
      </button>
    </header>
    <div class="itinerary-drawer__body" id="fare-body"></div>
  </aside>
</div>

<script define:vars={{ trip, search, PORCENTAJE_DESCUENTO, fromCity, toCity, origin, destination, depart, fromAirport, toAirport }}>
  const payload = { results: [], calendar: [], trip, from: { code: origin, city: fromCity, airport: fromAirport, country: '' }, to: { code: destination, city: toCity, airport: toAirport, country: '' }, depart, returnDate: '' };
  const list = document.getElementById('offers-list');
  const title = document.getElementById('offers-title');
  const sortLabel = document.getElementById('sort-label');
  const waiting = document.getElementById('offers-wait-screen');
  const timeoutBox = document.getElementById('offers-timeout');
  const errorBox = document.getElementById('offers-error');
  const emptyBox = document.getElementById('offers-empty');
  const state = { sort: 'recommended', stops: 'all', hours: 'all', step: 'outbound', outboundLeg: '', fare: '', outboundSelection: null };
  const discountPct = Number(PORCENTAJE_DESCUENTO) || 0;

  function show(el, on) {
    el?.classList.toggle('hidden', !on);
    if (on) el?.removeAttribute('hidden');
    else el?.setAttribute('hidden', '');
  }

  function money(value) {
    const n = Number(value) || 0;
    const [int, dec] = n.toFixed(2).split('.');
    return `USD ${int.replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${dec}`;
  }

  function ticketAfterDiscount(original, taxAmount) {
    const raw = Math.round((Number(original) || 0) * 100) / 100;
    const knownTax = taxAmount == null ? null : Math.round((Number(taxAmount) || 0) * 100) / 100;
    const tax = knownTax == null ? Math.round(raw * (233.56 / 1162.56) * 100) / 100 : knownTax;
    const fare = knownTax == null ? Math.max(0, Math.round((raw - tax) * 100) / 100) : raw;
    if (!(discountPct > 0)) return Math.round((fare + (knownTax == null ? tax : 0)) * 100) / 100;
    const fareAfter = Math.round(fare * (1 - Math.min(100, discountPct) / 100) * 100) / 100;
    return Math.round((fareAfter + (knownTax == null ? tax : 0)) * 100) / 100;
  }

  function ticketMoney(original) {
    const before = Number(original) || 0;
    if (!(discountPct > 0)) return money(before);
    const after = ticketAfterDiscount(before);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before)}</span><span class="ticket-price__now">${money(after)}</span></span>`;
  }

  function operatorMark(op) {
    const code = String(op.code || '').toUpperCase();
    const name = String(op.name || '');
    if (code === 'OB' || /boa|boliviana/i.test(name)) {
      return '<img class="flight-card__mark" src="/images/boa/logo.png" alt="" width="16" height="15">';
    }
    if (code === 'AV' || /avianca/i.test(name)) {
      return '<img class="flight-card__mark" src="/images/avianca/bird-mark.svg" alt="" width="16" height="15">';
    }
    if (/latam/i.test(name) || ['LA', 'XL', 'LP', '4C', 'LU', 'JJ', 'PZ'].includes(code)) {
      return '<img class="flight-card__mark" src="/images/avianca/bird-mark.svg" alt="" width="16" height="15">';
    }
    if (code === 'DL' || /delta/i.test(name)) {
      return '<img class="flight-card__mark flight-card__mark--delta" src="/images/airlines/delta.svg" alt="" width="13" height="13">';
    }
    if (code === 'AR' || code === 'AU' || /aerol[ií]neas argentinas|\baustral\b/i.test(name)) {
      return '<img class="flight-card__mark flight-card__mark--delta" src="/images/airlines/aerolineas.svg" alt="" width="13" height="13">';
    }
    return '';
  }

  function operatorsHtml(flight) {
    const raw = flight.operators || [];
    const list = raw.length
      ? raw.map((item) => (typeof item === 'string' ? { name: item, code: '' } : item)).map((op) => (
        /latam|avianca/i.test(op.name || '') ? { name: 'Boliviana de Aviación', code: op.code || 'OB' } : op
      ))
      : [{ name: flight.airline || 'Boliviana de Aviación', code: 'OB' }];
    const chips = list.map((op) => (
      `<span class="flight-card__op-item">${operatorMark(op)}<span>${op.name}</span></span>`
    )).join('<span class="flight-card__op-sep">|</span>');
    return `<p class="flight-card__op"><span class="flight-card__op-k">Operado por</span>${chips}</p>`;
  }

  function parseClock(value) {
    const match = String(value || '').match(/^(\d{1,2}):(\d{2})/);
    if (!match) return null;
    const hour24 = Number(match[1]);
    return {
      hour24,
      hour: hour24 % 12 || 12,
      mins: match[2],
      suffix: hour24 >= 12 ? 'p.m.' : 'a.m.',
    };
  }

  function clock24(value) {
    const match = String(value || '').match(/^(\d{1,2}):(\d{2})/);
    if (!match) return value || '';
    return `${String(match[1]).padStart(2, '0')}:${match[2]}`;
  }

  function durationAv(mins, label) {
    const n = Number(mins);
    if (Number.isFinite(n) && n > 0) {
      if (n >= 1440) {
        const days = Math.floor(n / 1440);
        const rem = n % 1440;
        const h = Math.floor(rem / 60);
        const m = rem % 60;
        return `${days} días ${h} h ${m} minutos`;
      }
      if (n < 60) return `${n} minutos`;
      const h = Math.floor(n / 60);
      const m = n % 60;
      if (!h) return `${m} minutos`;
      if (!m) return `${h} ${h === 1 ? 'hora' : 'horas'}`;
      return `${h} ${h === 1 ? 'hora' : 'horas'} y ${m} minutos`;
    }
    return String(label || '').replace(/\s*min\.?/g, ' minutos');
  }

  function stopsAv(flight) {
    const n = Number(flight.stopCount) || 0;
    if (n <= 0) return 'Vuelo Directo';
    return n === 1 ? '1 Conexión' : `${n} Conexiones`;
  }

  function boaMoney(value) {
    const n = Math.round((Number(value) || 0) * 10) / 10;
    return `USD ${n.toFixed(1)}`;
  }

  function boaChipMoney(value) {
    const n = Math.round(ticketAfterDiscount(value) * 10) / 10;
    return `USD. ${n.toFixed(1)}`;
  }

  function boaDealHtml(original, asFare = false) {
    const before = Number(original) || 0;
    const after = ticketAfterDiscount(before);
    const label = asFare ? boaFareMoney : boaMoney;
    if (!(discountPct > 0) || Math.abs(before - after) < 0.005) {
      return asFare ? label(before) : `<strong>${label(before)}</strong>`;
    }
    const note = `−${Math.round(Math.min(100, discountPct))}% en tarifa · impuestos sin cambio`;
    if (asFare) {
      return `<span class="boa-deal boa-deal--fare"><span class="boa-deal__was">${label(before)}</span><span class="boa-deal__now">${label(after)}</span><span class="boa-deal__note">${note}</span></span>`;
    }
    return `<span class="boa-deal"><span class="boa-deal__was">${label(before)}</span><strong class="boa-deal__now">${label(after)}</strong></span>`;
  }

  function shortAirport(name) {
    const raw = String(name || '').trim();
    if (/wilstermann/i.test(raw)) return 'Air Int Jorge Wilstermann';
    if (/el alto/i.test(raw)) return 'Air Int El Alto';
    return raw
      .replace(/^Airport Internacional /i, 'Air Int ')
      .replace(/^Aeropuerto Internacional (de )?/i, 'Air Int ')
      .replace(/^Aeropuerto de /i, 'Air Int ')
      .replace(/^Airport /i, 'Air ')
      .replace(/\s*Intl\.?$/i, '')
      .trim();
  }

  function boaCardDay(d) {
    const DAYS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
    const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
    return `${DAYS[d.getDay()]}. ${String(d.getDate()).padStart(2, '0')} ${MONTHS[d.getMonth()]}. ${d.getFullYear()}`;
  }

  function cardDay(iso, time) {
    const base = iso ? new Date(`${String(iso).slice(0, 10)}T12:00:00`) : null;
    let d = base && !Number.isNaN(base.getTime()) ? base : new Date();
    const clock = parseClock(time);
    if (clock && String(time || '').includes('+')) d.setDate(d.getDate() + 1);
    return boaCardDay(d);
  }

  function arriveDay(iso, flight) {
    const base = iso ? new Date(`${String(iso).slice(0, 10)}T12:00:00`) : new Date();
    if (flight.arriveNextDay) base.setDate(base.getDate() + 1);
    return boaCardDay(base);
  }

  function operatorsLine(flight) {
    const raw = flight.operators || [];
    const names = (raw.length
      ? raw.map((item) => (typeof item === 'string' ? item : item.name))
      : [flight.airline || 'Boliviana de Aviación']
    ).map((name) => (/latam|avianca/i.test(name || '') ? 'Boliviana de Aviación' : name)).filter(Boolean);
    const unique = [...new Set(names)];
    if (unique.length === 1) return `Operado por ${unique[0]}`;
    return `Operado por ${unique.slice(0, -1).join(', ')} y ${unique[unique.length - 1]}`;
  }

  function compareRecommended(a, b) {
    const departAsc = String(a.depart || '').localeCompare(String(b.depart || ''));
    if (departAsc) return departAsc;
    const duration = (Number(a.durationMinutes) || 0) - (Number(b.durationMinutes) || 0);
    if (duration) return duration;
    return Number(a.price) - Number(b.price);
  }

  function outboundKey(flight) {
    const segs = flight.itinerary || [];
    if (segs.length) {
      return segs.map((s) => `${s.flightNumber}|${s.depart}|${s.originCode}|${s.destCode}|${s.arrive}`).join('>');
    }
    return `${flight.flightNumber}|${flight.depart}|${flight.arrive}|${flight.stopCount}`;
  }

  function uniqueOutbound(rows) {
    const map = new Map();
    for (const flight of rows) {
      const key = outboundKey(flight);
      const prev = map.get(key);
      if (!prev || flight.price < prev.price) map.set(key, flight);
    }
    return [...map.values()].sort(compareRecommended);
  }

  function viaLatamHub(flight) {
    const segs = flight.itinerary || [];
    if (segs.length < 2) return false;
    const hubs = { GUA: 1, SAL: 1, SAP: 1, MIA: 1, BOG: 1, MEX: 1, LIM: 1, SCL: 1, LAX: 1, IAD: 1 };
    return segs.slice(0, -1).some((seg) => hubs[String(seg.destCode || '').toUpperCase()]);
  }

  function fareIcon(kind, color) {
    const fill = color || 'currentColor';
    const paths = {
      personal: '<path fill-rule="evenodd" clip-rule="evenodd" d="M12.4688 14.4479C13.013 14.4479 13.4583 14.0026 13.4583 13.4583V7.52084C13.4583 6.60052 12.825 5.8336 11.974 5.61094V4.55209H10.4896V5.54167H8.51042V4.55209H7.02604V5.61094C6.175 5.8336 5.54167 6.60052 5.54167 7.52084V13.4583C5.54167 14.0026 5.98698 14.4479 6.53125 14.4479H12.4688ZM6.53125 10.4896V9.5H12.4688V11.4792H11.4792V10.4896H6.53125Z" fill="currentColor"/>',
      carry: '<path d="M11.34 2.375C11.7389 2.375 12.0659 2.71359 12.0659 3.12724V9.15751H13.5163C14.3142 9.15751 14.2484 9.8347 14.2484 10.662V15.1607C14.2485 15.9879 14.3141 16.6644 13.5163 16.6644C13.5163 17.078 13.19 17.4166 12.7911 17.4167C12.3922 17.4167 12.0659 17.0781 12.0659 16.6644H7.71333C7.71333 17.0781 7.38707 17.4166 6.98815 17.4167C6.5892 17.4167 6.26297 17.0781 6.26297 16.6644C5.66453 16.6644 5.55916 16.2838 5.54398 15.7444V10.0775C5.55918 9.53823 5.66461 9.15751 6.26297 9.15751H7.71333V3.12724C7.71333 2.7137 8.0397 2.37518 8.43851 2.375H11.34ZM7.91743 14.7626H8.7091V10.7316H7.91743V14.7626ZM11.0833 14.7626H11.875V10.7316H11.0833V14.7626ZM8.70678 3.16667V9.01603H11.0818V3.16667H8.70678Z" fill="currentColor"/>',
      hold: '<path d="M11.0833 1.58333C11.5187 1.58333 11.875 1.93958 11.875 2.37499V4.74999H13.4583C14.3291 4.74999 15.0416 5.46249 15.0416 6.33333V15.0417C15.0416 15.9125 14.3291 16.625 13.4583 16.625C13.4583 17.0604 13.1021 17.4167 12.6666 17.4167C12.2312 17.4167 11.875 17.0604 11.875 16.625H7.12498C7.12498 17.0604 6.76873 17.4167 6.33331 17.4167C5.8979 17.4167 5.54165 17.0604 5.54165 16.625C4.67081 16.625 3.95831 15.9125 3.95831 15.0417V6.33333C3.95831 5.46249 4.67081 4.74999 5.54165 4.74999H7.12498V2.37499C7.12498 1.93958 7.48123 1.58333 7.91665 1.58333H11.0833ZM6.33331 14.25H7.52081V7.12499H6.33331V14.25ZM8.90546 14.25H10.093V7.12499H8.90546V14.25ZM11.4799 7.12499V14.25H12.6674V7.12499H11.4799ZM8.31171 4.74999H10.6867V2.77083H8.31171V4.74999Z" fill="currentColor"/>',
      miles: '<path d="M11.7605 13.923H13.2547C13.8763 13.923 14.1504 13.9741 14.3242 14.0566C14.0578 13.2153 13.2199 12.5627 10.2702 12.3386C10.7412 12.8929 11.2354 13.4276 11.7605 13.9269V13.923Z" fill="currentColor"/><path d="M10.274 12.3386C7.40921 8.94957 5.47873 4.61308 4.70654 1C4.70654 1 3.13126 2.41535 3.00771 5.3876C2.86872 8.63898 4.58299 11.914 10.22 12.3307C10.2393 12.3307 10.2586 12.3307 10.274 12.3386Z" fill="currentColor"/><path d="M11.7605 13.923C9.5366 13.923 5.69881 13.923 5.69881 13.923C5.77989 14.1156 6.05788 14.2493 6.68722 14.2886C10.471 14.5166 11.0038 17.54 16.4207 17.54C16.8956 17.54 17.1929 17.5125 17.4902 17.4535C15.3512 16.7851 13.4285 15.5231 11.7567 13.923L11.7605 13.923Z" fill="currentColor"/>',
      seat: '<path fill-rule="evenodd" clip-rule="evenodd" d="M16.4337 11.0713C16.4337 11.0713 16.0909 10.0649 15.0575 9.23604L11.375 10.0745L9.08966 10.5915L7.98981 8.4602L6.91006 6.53404L5.61 4.19346C5.61 4.19346 4.97701 3.03832 3.43739 3.44241C3.43739 3.44241 3.39193 3.45549 3.32374 3.48165L2.96353 1.92172C2.91107 1.69868 2.63829 1.5493 2.35503 1.58991L2.01318 1.63879C1.72991 1.67941 1.54019 1.89488 1.59177 2.11792L2.20989 4.79238C2.22301 4.8502 2.25273 4.90252 2.29295 4.94865C2.30781 5.15104 2.35677 5.37477 2.46519 5.63017L6.15031 12.2513L7.00798 13.7685C7.00798 13.7685 7.34458 14.4149 7.73626 14.5863L7.73976 15.4276L7.73626 16.3356L7.72053 16.8794C7.72053 16.8794 7.79484 17.3627 8.2757 17.3861C8.75656 17.4095 10.534 17.3923 10.534 17.3923H12.8622L14.6842 17.3888C14.6842 17.3888 15.1126 17.3744 15.2385 17.0136L15.2717 16.5187L15.2639 15.6079L15.2682 14.4989L15.2752 13.1634C15.2752 13.1634 15.9817 13.0794 16.4372 12.601C16.4372 12.601 16.8621 12.2705 16.4337 11.0713Z" fill="currentColor"/>',
      plus: '<path fill-rule="evenodd" clip-rule="evenodd" d="M16.4337 11.0713C16.4337 11.0713 16.091 10.0649 15.0576 9.23604L11.3751 10.0745L9.08969 10.5915L7.98984 8.4602L6.91009 6.53404L5.61003 4.19346C5.61003 4.19346 4.97704 3.03832 3.43742 3.44241C3.43742 3.44241 3.39196 3.45549 3.32377 3.48165L2.96356 1.92172C2.9111 1.69868 2.63833 1.5493 2.35506 1.58991L2.01321 1.63879C1.72994 1.67941 1.54022 1.89488 1.5918 2.11792L2.20992 4.79238C2.22304 4.8502 2.25276 4.90252 2.29298 4.94865C2.30784 5.15104 2.3568 5.37477 2.46522 5.63017L6.15034 12.2513L7.00801 13.7685C7.00801 13.7685 7.34461 14.4149 7.73629 14.5863L7.73979 15.4276L7.73629 16.3356L7.72056 16.8794C7.72056 16.8794 7.79487 17.3627 8.27573 17.3861C8.75659 17.4095 10.534 17.3923 10.534 17.3923H12.8622L14.6843 17.3888C14.6843 17.3888 15.1127 17.3744 15.2385 17.0136L15.2718 16.5187L15.2639 15.6079L15.2683 14.4989L15.2753 13.1634C15.2753 13.1634 15.9817 13.0794 16.4372 12.601C16.4372 12.601 16.8621 12.2705 16.4337 11.0713Z" fill="currentColor"/>',
