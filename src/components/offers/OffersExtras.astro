---
const circle = `<circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1" fill="none"/>`;

const services = [
  {
    label: 'Tomacorriente*',
    icon: `${circle}<path d="M12.4 13.2v3.6c0 2 1.6 3.6 3.6 3.6s3.6-1.6 3.6-3.6v-3.6" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M14.2 10.2v3.4M17.8 10.2v3.4M16 20.4v2.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>`,
  },
  {
    label: 'Entretenimiento a bordo (en pantalla frente al asiento)**',
    icon: `${circle}<circle cx="16" cy="16" r="5.4" stroke="currentColor" stroke-width="1.15"/><path d="M14.5 13.4v5.2l4.6-2.6-4.6-2.6Z" fill="currentColor"/>`,
  },
  {
    label: 'Cargador USB**',
    icon: `${circle}<path d="M16 9.6v8.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><circle cx="16" cy="20.2" r="1.55" stroke="currentColor" stroke-width="1.15"/><path d="M16 13.4h4.4a1.7 1.7 0 0 0 1.7-1.7V10.4" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M16 12.2h-4.4A1.7 1.7 0 0 1 9.9 10.5V9.6" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><circle cx="22.1" cy="9.4" r="1.15" stroke="currentColor" stroke-width="1.1"/><rect x="9.1" y="8.2" width="1.9" height="2.4" rx="0.3" stroke="currentColor" stroke-width="1.1"/>`,
  },
  {
    label: 'Servicio de alimentación***',
    icon: `${circle}<path d="M11.2 20.6h9.6" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M12.4 20.6c0-3.8 1.6-6.4 3.6-6.4s3.6 2.6 3.6 6.4" stroke="currentColor" stroke-width="1.15"/><path d="M16 11.2v2.6" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><circle cx="16" cy="10.6" r="0.85" fill="currentColor"/><path d="M11.6 18.2h8.8" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>`,
  },
  {
    label: 'Tomacorriente con cargador USB*',
    icon: `${circle}<path d="M10.6 13v3.2c0 1.6 1.3 2.9 2.9 2.9h.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M12 10.4v3M14.2 10.4v3" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M18.2 11.2v7.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><circle cx="18.2" cy="20.4" r="1.25" stroke="currentColor" stroke-width="1.1"/><path d="M18.2 14.4h2.6a1.2 1.2 0 0 0 1.2-1.2v-.8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>`,
  },
  {
    label: 'Bebidas alcohólicas y no alcohólicas***',
    icon: `${circle}<path d="M11.6 10.8h8.8L16 17.6V22" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.4 22h5.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M16 10.8l-2.2 3.4" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>`,
  },
  {
    label: 'Entretenimiento a bordo (app BoA)**',
    icon: `${circle}<rect x="11.4" y="9.4" width="9.2" height="13.2" rx="1.4" stroke="currentColor" stroke-width="1.15"/><path d="M14.6 13.6v4.8l4.2-2.4-4.2-2.4Z" fill="currentColor"/>`,
  },
  {
    label: 'Wifi**',
    icon: `${circle}<path d="M11.2 14.6a7.2 7.2 0 0 1 9.6 0" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M12.8 16.8a4.8 4.8 0 0 1 6.4 0" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><path d="M14.4 18.8a2.4 2.4 0 0 1 3.2 0" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/><circle cx="16" cy="21.1" r="0.95" fill="currentColor"/>`,
  },
];
---

<section class="offers-extras hidden" id="offers-extras" hidden>
  <h2>Servicios a bordo:</h2>
  <ul class="offers-services">
    {services.map((item) => (
      <li>
        <span class="offers-services__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" set:html={item.icon} />
        </span>
        <span class="offers-services__label">{item.label}</span>
      </li>
    ))}
  </ul>
  <p class="offers-extras__note">(*) Dependiendo de la cabina y tipo de avión (**) Dependiendo del tipo de avión (***) Con cargo extra dependiendo de la ruta y sujeto a restricciones gubernamentales locales</p>

  <h2>Información general de vuelos</h2>
  <ul class="offers-legal">
    <li>Los precios están sujetos a confirmación al momento de emitir. Las tarifas promocionales tienen cupos limitados.</li>
    <li>Para viajes con ida y vuelta: el vuelo de ida que elijas determinará los precios de los vuelos de regreso.</li>
    <li>Debes volar los tramos en el orden consecutivo del itinerario.</li>
    <li>Descuentos para adultos mayores o personas con discapacidad solo se aplican en <strong>oficinas BoA y Contact Center</strong>.</li>
    <li>El <strong>upgrade de cabina</strong> aplica según la tarifa (Basic, Light, Classic o Flex) y disponibilidad.</li>
    <li>Revisa los <strong>requisitos para viajar</strong> según destino, incluyendo visas y vacunas.</li>
    <li>Puedes acumular millas <strong>BoA</strong> en trayectos operados por Boliviana de Aviación.</li>
    <li>Por flexibilidad ante imprevistos, <strong>revisa tus derechos</strong> y alternativas vigentes.</li>
  </ul>
</section>
